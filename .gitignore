# Dependencies
node_modules/

# Lockfiles — this repo does not track them (no pnpm-lock.yaml at the root
# either); installs are resolved from the manifests.
package-lock.json
pnpm-lock.yaml

# Transient build outputs.
#
# functions/lib/ is deliberately NOT here: it is committed, and firebase.json's
# predeploy (`npm run build`) regenerates it on every deploy. The two below are
# different — they are scratch artifacts produced by `npm run build:core` on the
# way to running the timing sweep, and were never tracked.
functions/timing-core.cjs
functions/.tmp-core/

# Local env / editor
.env
.env.local
.DS_Store
