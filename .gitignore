node_modules/

# Firestore emulator writes this wherever it is started from.
firestore-debug.log
firebase-debug.log

# Judge0 cluster secrets — never commit
infra/judge0/.env.judge0

# Build output — Vercel runs vite build itself; a committed copy is dead weight
dist/

# Downloaded by postinstall (face-api weights), not source
public/models/

# The ROOT project uses pnpm (pnpm-lock.yaml / pnpm-workspace.yaml). An npm
# install here writes a second, conflicting lockfile — anchored to the root so
# functions/package-lock.json, which is genuine (functions installs with npm),
# is unaffected.
/package-lock.json
