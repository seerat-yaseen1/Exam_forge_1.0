rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════════
// STRATUM — Firestore Security Rules (Phase 6 — Firebase Auth migration)
// ═══════════════════════════════════════════════════════════════════════════════
//
// These rules assume Firebase Authentication is the source of truth.
// Every signed-in user has a custom claim payload of one of these shapes:
//
//   { role: 'webOwner' }
//   { role: 'institute', instituteId }
//   { role: 'faculty',   instituteId, facultyId }
//   { role: 'student',   instituteId, studentId }
//
// Phase 6+ (this file) — role-scoped, not merely authenticated:
//   ✅ Reads & writes require request.auth != null (public-read hole closed)
//   ✅ webowners can only be written by Web Owners; deletion always blocked
//   ✅ Credential collections (institute/faculty/student) scoped by claim
//   ✅ Assessment / question / attempt / answer-key rules scoped by owner
//      and by materialized membership (see attempts + assessments blocks)
//   ✅ Academic hierarchy + mappings reads scoped to staff / own-student
//      (Audit N8, 2026-07-17)
//   ✅ Entity-lifecycle audit trail append-only + tenant-scoped reads;
//      deletionRequests reserved and denied until Phase 4
//      (Feature #15, Phase 0b)
//   ✅ Test collections blocked; unknown paths fall through to default deny
//
// Remaining deferrals are tracked in REMEDIATION_PLAN.md, not here (so this
// header can't drift stale again): per-institute scoping of individual staff
// hierarchy reads waits on the repo split (queries need instituteId filters),
// and the legacy assignedTo path is retired with N6.
// ═══════════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return request.auth.token.role;
    }

    function isWebOwner() {
      return signedIn() && role() == 'webOwner';
    }

    // True when the caller is the Institute Admin for this institute.
    // Doc ID == claim.instituteId for institutes/credentials/logos/configs.
    function isInstituteSelf(instituteId) {
      return signedIn()
        && role() == 'institute'
        && request.auth.token.instituteId == instituteId;
    }

    // True when the caller is an Institute Admin governing the given institute.
    // Use this when checking a doc that *belongs* to an institute (faculty,
    // student, school, course, …) — pass in the doc's instituteId field.
    function isInstituteOf(instituteId) {
      return signedIn()
        && role() == 'institute'
        && request.auth.token.instituteId == instituteId;
    }

    // True when the caller is the same Faculty member as the doc.
    // Migrated faculty: claim.facultyId == legacy doc id.
    // New faculty (post createAuthUser wiring): claim.facultyId == uid.
    function isFacultySelf(facultyId) {
      return signedIn()
        && role() == 'faculty'
        && request.auth.token.facultyId == facultyId;
    }

    // True when the caller is the same Student as the doc.
    function isStudentSelf(studentId) {
      return signedIn()
        && role() == 'student'
        && request.auth.token.studentId == studentId;
    }

    // Any staff principal (non-student). Role-only conditions are provable
    // for every query shape, which is what lets Batch B scope the academic
    // collections without touching the parent-keyed client queries
    // (levels-by-school, programs-by-level, …). Full per-institute staff
    // scoping is deferred to the repo split (Batch F5), when those queries
    // gain instituteId filters — see REMEDIATION_PLAN.md.
    function isStaff() {
      return signedIn()
        && (role() == 'webOwner' || role() == 'institute' || role() == 'faculty');
    }

    function str(val) {
      return val is string && val.size() > 0;
    }


    // ─────────────────────────────────────────────────────────────────────────
    // webowners/{uid}
    //
    // Post-migration the document ID is the Firebase Auth uid (not the email).
    // Plaintext password is no longer stored — Firebase Auth holds the secret.
    // Only Web Owners may mutate; deletes remain hard-blocked.
    // ─────────────────────────────────────────────────────────────────────────
    // ── Phase 3: platform-wide SEB settings ────────────────────────
    // Holds the SEB Config Key(s). Only the webOwner may read or write them
    // from a client. Cloud Functions read via the Admin SDK (bypasses rules),
    // which is what lets the server verify a request without ever exposing
    // the keys to a student's browser — the key must stay secret, because
    // possessing it is what would let an attacker forge the SEB hash.
    match /platformSettings/{settingId} {
      allow read, write: if isWebOwner();
    }

    // ── Phase 3 Stage 4b: student-readable platform SEB info ───────
    // ONLY the non-secret half: the platform .seb file's download link and
    // name, so the briefing gate can offer the file. The Config Keys stay in
    // platformSettings/seb (webOwner-only). Splitting the doc is what lets
    // students see the link without ever being able to read the keys.
    match /publicSettings/{settingId} {
      allow read: if signedIn();
      allow write: if isWebOwner();
    }

    // ── Phase 3 Stage 4: per-assessment SEB Config Keys ────────────
    // DELIBERATELY a separate collection, NOT a field on the assessment doc:
    // assessments are student-readable, and possessing a Config Key is what
    // lets an attacker forge the SEB hash. The verification endpoint reads
    // this collection with a service account (bypasses rules); no student
    // client ever can. The (unused) Assessment.sebConfigKeys schema field is
    // retired in favour of this collection.
    match /sebAssessmentKeys/{assessmentId} {
      allow read, write: if isWebOwner();
    }

    match /webowners/{ownerId} {
      allow read:   if isWebOwner();
      allow create: if isWebOwner() && str(request.resource.data.email) && str(request.resource.data.name);
      // A web owner may only update their OWN doc — prevents one admin from
      // overwriting another's name / email if multi-owner is ever enabled.
      allow update: if isWebOwner() && request.auth.uid == ownerId;
      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // institutes/{instituteId}
    // Read: webOwner (management UI, list queries), or any member of THAT
    //       institute — every auth context reads its own institute doc by id
    //       from the claim, so per-doc gets stay provable. The previous
    //       signedIn() read exposed the full institute directory (names,
    //       codes, admin emails, activeUntil) to every student on the
    //       platform. Code→institute lookups for password reset no longer
    //       exist client-side (reset is email-based, unauthenticated-safe).
    // ─────────────────────────────────────────────────────────────────────────
    match /institutes/{instituteId} {
      allow read:   if isWebOwner()
                       || (signedIn() && request.auth.token.instituteId == instituteId);
      allow create: if isWebOwner();
      allow update: if isWebOwner() || isInstituteSelf(instituteId);
      // LOCKED (Feature #15, Phase 6b). Client deletes are gone: every
      // removal now goes through the deleteAuthUser / purgeEntity callables,
      // which enforce the deletion-rights ceiling, write the audit row and
      // run the cascade. A client-side delete would bypass all three.
      // Verified before locking: no call site in src/ deletes these
      // collections directly (deleteInstitute was imported but never called).
      allow delete: if false;
    }

    // instituteCredentials — only holds firstLoginRequired + migration
    // metadata post-migration. Read: webOwner + the institute itself (the
    // auth context's own per-doc get). Was signedIn() — cross-tenant
    // metadata leak.
    match /instituteCredentials/{instituteId} {
      allow read:   if isWebOwner() || isInstituteSelf(instituteId);
      allow create: if isWebOwner();
      allow update: if isWebOwner() || isInstituteSelf(instituteId);
      // LOCKED (Feature #15, Phase 6b). Client deletes are gone: every
      // removal now goes through the deleteAuthUser / purgeEntity callables,
      // which enforce the deletion-rights ceiling, write the audit row and
      // run the cascade. A client-side delete would bypass all three.
      // Verified before locking: no call site in src/ deletes these
      // collections directly (deleteInstitute was imported but never called).
      allow delete: if false;
    }

    // Logo upload: institute admin manages own; webOwner override; structural
    // validation kept from Phase 6a.
    match /instituteLogos/{instituteId} {
      allow read:   if signedIn();
      allow create, update: if (isWebOwner() || isInstituteSelf(instituteId)) &&
        str(request.resource.data.dataUrl) &&
        str(request.resource.data.updatedAt) &&
        request.resource.data.dataUrl.size() <= 950000;
      allow delete: if isWebOwner();
    }

    // instituteConfigs — collection has no callers in app code. Lock to
    // webOwner only so a stray client write can't repopulate it.
    match /instituteConfigs/{instituteId} {
      allow read:   if signedIn();
      allow create, update, delete: if isWebOwner();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // faculty / facultyCredentials
    //
    // Writers:
    //   • webOwner  — anywhere
    //   • institute — only for faculty whose instituteId matches caller's claim
    //   • faculty   — self-update only (e.g. flipping firstLoginRequired=false)
    //
    // Credentials docs don't carry instituteId, so we resolve the parent
    // faculty doc via get() to authorise institute-admin writes. This adds one
    // extra doc read per credentials write (acceptable — written rarely).
    // ─────────────────────────────────────────────────────────────────────────
    match /faculty/{facultyId} {
      allow read:   if isWebOwner()
                       || isFacultySelf(facultyId)
                       || ((role() == 'institute' || role() == 'faculty')
                           && request.auth.token.instituteId == resource.data.instituteId);
      allow create: if isWebOwner()
                       || isInstituteOf(request.resource.data.instituteId);
      // N4: isFacultySelf removed from update — no client code self-writes
      // the profile doc (contexts write facultyCredentials only), and the
      // clause let any faculty member set canCreateStudents on themselves.
      allow update: if isWebOwner()
                       || isInstituteOf(resource.data.instituteId);
      // LOCKED (Feature #15, Phase 6b). Client deletes are gone: every
      // removal now goes through the deleteAuthUser / purgeEntity callables,
      // which enforce the deletion-rights ceiling, write the audit row and
      // run the cascade. A client-side delete would bypass all three.
      // Verified before locking: no call site in src/ deletes these
      // collections directly (deleteInstitute was imported but never called).
      allow delete: if false;
    }

    match /facultyCredentials/{facultyId} {
      // Read: webOwner, the faculty member themself (auth context's own
      // per-doc get), or their institute admin (resolved via the parent
      // faculty doc, mirroring the create/update clauses). Was signedIn().
      allow read:   if isWebOwner()
                       || isFacultySelf(facultyId)
                       || (
                            exists(/databases/$(database)/documents/faculty/$(facultyId))
                            && isInstituteOf(get(/databases/$(database)/documents/faculty/$(facultyId)).data.instituteId)
                          );
      allow create: if isWebOwner()
                       || (
                            exists(/databases/$(database)/documents/faculty/$(facultyId))
                            && isInstituteOf(get(/databases/$(database)/documents/faculty/$(facultyId)).data.instituteId)
                          );
      allow update: if isWebOwner()
                       || isFacultySelf(facultyId)
                       || (
                            exists(/databases/$(database)/documents/faculty/$(facultyId))
                            && isInstituteOf(get(/databases/$(database)/documents/faculty/$(facultyId)).data.instituteId)
                          );
      // LOCKED (Feature #15, Phase 6b). Client deletes are gone: every
      // removal now goes through the deleteAuthUser / purgeEntity callables,
      // which enforce the deletion-rights ceiling, write the audit row and
      // run the cascade. A client-side delete would bypass all three.
      // Verified before locking: no call site in src/ deletes these
      // collections directly (deleteInstitute was imported but never called).
      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // students / studentCredentials
    //
    // Writers:
    //   • webOwner  — anywhere
    //   • institute — only for students whose instituteId matches caller's claim
    //   • faculty   — only for students in the same institute (faculty's
    //                 individual canCreateStudents gate is enforced app-side)
    //   • student   — self-update only
    // ─────────────────────────────────────────────────────────────────────────
    match /students/{studentId} {
      allow read:   if isWebOwner()
                       || isStudentSelf(studentId)
                       || ((role() == 'institute' || role() == 'faculty')
                           && request.auth.token.instituteId == resource.data.instituteId);
      allow create: if isWebOwner()
                       || isInstituteOf(request.resource.data.instituteId)
                       || (role() == 'faculty'
                           && request.auth.token.instituteId == request.resource.data.instituteId);
      allow update: if isWebOwner()
                       || isInstituteOf(resource.data.instituteId)
                       || (role() == 'faculty'
                           && request.auth.token.instituteId == resource.data.instituteId);
      // N4: isStudentSelf removed from update — no client code self-writes
      // the profile doc (contexts write studentCredentials only), and the
      // clause let a disabled student flip their own status back to active.
      // LOCKED (Feature #15, Phase 6b). Client deletes are gone: every
      // removal now goes through the deleteAuthUser / purgeEntity callables,
      // which enforce the deletion-rights ceiling, write the audit row and
      // run the cascade. A client-side delete would bypass all three.
      // Verified before locking: no call site in src/ deletes these
      // collections directly (deleteInstitute was imported but never called).
      allow delete: if false;
    }

    match /studentCredentials/{studentId} {
      // Read: webOwner, the student themself, or institute/faculty of that
      // student's institute (resolved via the parent student doc, mirroring
      // the create/update clauses). Was signedIn().
      allow read:   if isWebOwner()
                       || isStudentSelf(studentId)
                       || (
                            exists(/databases/$(database)/documents/students/$(studentId))
                            && (
                                 isInstituteOf(get(/databases/$(database)/documents/students/$(studentId)).data.instituteId)
                                 || (role() == 'faculty'
                                     && request.auth.token.instituteId == get(/databases/$(database)/documents/students/$(studentId)).data.instituteId)
                               )
                          );
      allow create: if isWebOwner()
                       || (
                            exists(/databases/$(database)/documents/students/$(studentId))
                            && (
                                 isInstituteOf(get(/databases/$(database)/documents/students/$(studentId)).data.instituteId)
                                 || (role() == 'faculty'
                                     && request.auth.token.instituteId == get(/databases/$(database)/documents/students/$(studentId)).data.instituteId)
                               )
                          );
      allow update: if isWebOwner()
                       || isStudentSelf(studentId)
                       || (
                            exists(/databases/$(database)/documents/students/$(studentId))
                            && (
                                 isInstituteOf(get(/databases/$(database)/documents/students/$(studentId)).data.instituteId)
                                 || (role() == 'faculty'
                                     && request.auth.token.instituteId == get(/databases/$(database)/documents/students/$(studentId)).data.instituteId)
                               )
                          );
      // LOCKED (Feature #15, Phase 6b). Client deletes are gone: every
      // removal now goes through the deleteAuthUser / purgeEntity callables,
      // which enforce the deletion-rights ceiling, write the audit row and
      // run the cascade. A client-side delete would bypass all three.
      // Verified before locking: no call site in src/ deletes these
      // collections directly (deleteInstitute was imported but never called).
      allow delete: if false;
    }

    // ═════════════════════════════════════════════════════════════════════════
    // ACADEMIC HIERARCHY
    //
    // Every doc in these collections carries `instituteId`. Writes require:
    //   • webOwner, OR
    //   • institute admin / faculty whose claim instituteId matches the doc's.
    //
    // Hard-deletes are blocked everywhere except academicMappings, which is
    // how a student gets unassigned from a node.
    // ═════════════════════════════════════════════════════════════════════════

    function canWriteAcademic(instituteId) {
      return signedIn()
        && (role() == 'webOwner'
            || ((role() == 'institute' || role() == 'faculty')
                && request.auth.token.instituteId == instituteId));
    }

    match /schools/{id} {
      allow read:   if isStaff();   // N8: students read node names via their denormalized academicMappings, never these collections
      allow create: if canWriteAcademic(request.resource.data.instituteId);
      allow update: if canWriteAcademic(resource.data.instituteId);
      allow delete: if false;
    }
    match /academicLevels/{id} {
      allow read:   if isStaff();   // N8: students read node names via their denormalized academicMappings, never these collections
      allow create: if canWriteAcademic(request.resource.data.instituteId);
      allow update: if canWriteAcademic(resource.data.instituteId);
      allow delete: if false;
    }
    match /programs/{id} {
      allow read:   if isStaff();   // N8: students read node names via their denormalized academicMappings, never these collections
      allow create: if canWriteAcademic(request.resource.data.instituteId);
      allow update: if canWriteAcademic(resource.data.instituteId);
      allow delete: if false;
    }
    match /academicSessions/{id} {
      allow read:   if isStaff();   // N8: students read node names via their denormalized academicMappings, never these collections
      allow create: if canWriteAcademic(request.resource.data.instituteId);
      allow update: if canWriteAcademic(resource.data.instituteId);
      allow delete: if false;
    }
    match /academicYears/{id} {
      allow read:   if isStaff();   // N8: students read node names via their denormalized academicMappings, never these collections
      allow create: if canWriteAcademic(request.resource.data.instituteId);
      allow update: if canWriteAcademic(resource.data.instituteId);
      allow delete: if false;
    }
    match /semesters/{id} {
      allow read:   if isStaff();   // N8: students read node names via their denormalized academicMappings, never these collections
      allow create: if canWriteAcademic(request.resource.data.instituteId);
      allow update: if canWriteAcademic(resource.data.instituteId);
      allow delete: if false;
    }
    match /courses/{id} {
      allow read:   if isStaff();   // N8: students read node names via their denormalized academicMappings, never these collections
      allow create: if canWriteAcademic(request.resource.data.instituteId);
      allow update: if canWriteAcademic(resource.data.instituteId);
      allow delete: if false;
    }
    match /sections/{id} {
      allow read:   if isStaff();   // N8: students read node names via their denormalized academicMappings, never these collections
      allow create: if canWriteAcademic(request.resource.data.instituteId);
      allow update: if canWriteAcademic(resource.data.instituteId);
      allow delete: if false;
    }
    match /groups/{id} {
      allow read:   if isStaff();   // N8: students read node names via their denormalized academicMappings, never these collections
      allow create: if canWriteAcademic(request.resource.data.instituteId);
      allow update: if canWriteAcademic(resource.data.instituteId);
      allow delete: if false;
    }
    match /academicMappings/{id} {
      // N8: was signedIn() — any student could enumerate every institute's
      // student→node directory. Students keep reading their OWN mappings
      // (profile + landing pages query where studentId == claim; provable).
      allow read:   if isStaff()
                       || (role() == 'student'
                           && resource.data.studentId == request.auth.token.studentId);
      allow create: if canWriteAcademic(request.resource.data.instituteId);
      allow update: if false;     // mappings are immutable
      allow delete: if canWriteAcademic(resource.data.instituteId);
    }

    // ═════════════════════════════════════════════════════════════════════════
    // ASSESSMENT / EXAM DATA
    // ═════════════════════════════════════════════════════════════════════════
    // Owned content (assessments / questions) — writer must match the doc's
    // ownerType + ownerId. webOwner is always allowed.
    //   ownerType ∈ {'webOwner', 'institute', 'faculty'}
    //   ownerId   ∈ {'webOwner', instituteId, facultyId}
    function canWriteOwned(ownerType, ownerId) {
      return isWebOwner()
        || (ownerType == 'institute' && role() == 'institute'
            && request.auth.token.instituteId == ownerId)
        || (ownerType == 'faculty'   && role() == 'faculty'
            && request.auth.token.facultyId == ownerId);
    }

    // Tenant stamp check for question docs (permission-model Phase 0):
    // institute/faculty-authored content must be stamped with the writer's
    // own institute; webOwner content must carry no stamp. Evaluated on the
    // FINAL doc state (create payload / post-merge update result).
    function questionInstituteStampOk(d) {
      return d.get('ownerType', 'webOwner') == 'webOwner'
        ? !('instituteId' in d)
        : d.get('instituteId', '') == request.auth.token.instituteId;
    }

    match /assessments/{id} {
      // Read access:
      //   • webOwner — always (owns all content)
      //   • institute / faculty — their OWN assessments in any status
      //     (canWriteOwned; owners must be able to read back their drafts to
      //     edit and publish them — the previous `status != 'draft'` clause
      //     made drafts unreadable to their own creators AND was unprovable
      //     for the list queries, so every institute/faculty listing query was
      //     rejected wholesale), PLUS published assessments assigned to their
      //     institute (assignedTo.type == 'all', or their instituteId in
      //     assignedTo.instituteIds).
      //   • student — only published docs (list queries filter by
      //     status == active|closed; the startExam Cloud Function enforces
      //     assignedTo server-side before an attempt can be created).
      //
      // Query provability notes (keep queries and rule in sync):
      //   owner listing     → where ownerType==, ownerId==        (provable)
      //   assigned-to-all   → where assignedTo.type=='all',
      //                        status=='active'|'closed'          (provable)
      //   assigned-to-mine  → where assignedTo.instituteIds
      //                        array-contains <claim instituteId>,
      //                        status=='active'|'closed'          (provable)
      allow read: if isWebOwner()
                     || (role() == 'student'
                         && resource.data.status in ['active', 'closed'])
                     || ((role() == 'institute' || role() == 'faculty')
                         && canWriteOwned(resource.data.ownerType, resource.data.ownerId))
                     || ((role() == 'institute' || role() == 'faculty')
                         && resource.data.status in ['active', 'closed']
                         && (resource.data.assignedTo.type == 'all'
                             || (resource.data.assignedTo.type == 'institutes'
                                 && request.auth.token.instituteId in resource.data.assignedTo.instituteIds)));
      allow create: if canWriteOwned(request.resource.data.ownerType,
                                     request.resource.data.ownerId);
      // Owners edit freely UNTIL the first attempt sets securityLockedAt
      // (stamped by the startExam Cloud Function via the Admin SDK, which
      // bypasses these rules). Once locked, the security-relevant fields are
      // immutable; schedule / access / cosmetic fields may still change.
      // Legacy docs (no securityLockedAt) remain fully editable — they carry
      // no security config to protect.
      allow update: if canWriteOwned(resource.data.ownerType, resource.data.ownerId)
                       // allocationMode is stamped by the resolveAllocation Cloud
                       // Function (Admin SDK) — clients may never set or change it.
                       && request.resource.data.get('allocationMode', null)
                            == resource.data.get('allocationMode', null)
                       && (
                            !('securityLockedAt' in resource.data)
                            || (
                                 request.resource.data.securityTier == resource.data.securityTier
                                 && request.resource.data.deliveryMode == resource.data.deliveryMode
                                 && request.resource.data.requireCamera == resource.data.requireCamera
                                 && request.resource.data.allowMobile == resource.data.allowMobile
                                 && request.resource.data.requireExtensionCheck == resource.data.requireExtensionCheck
                                 && request.resource.data.autoResume == resource.data.autoResume
                                 && request.resource.data.securityLockedAt == resource.data.securityLockedAt
                               )
                          );
      allow delete: if canWriteOwned(resource.data.ownerType,
                                     resource.data.ownerId);
    }

    // attempts/{id}
    //   create: webOwner only (manual-repair escape hatch). Attempt docs are
    //     created EXCLUSIVELY by the startExam Cloud Function (Admin SDK,
    //     bypasses these rules) — students must NOT be able to create them
    //     directly, or a forged doc with status:'submitted' + fabricated
    //     scores would land straight in the roster and results pages, which
    //     trust the doc. (Audit 2026-07-17, N1: the previous C1 fix hardened
    //     updates but left the student create clause open.)
    //   update:
    //     • student — only while in_progress, and only on a whitelisted set of
    //       fields the exam shell needs (answers, timings, integrity log,
    //       session tracking). Status transitions, scores, gradedAnswers,
    //       submittedAt, freeze fields, and identity fields are OFF-LIMITS to
    //       the student client; those are written by the gradeAttempt Cloud
    //       Function (admin SDK, bypasses these rules).
    //     • institute / faculty (same institute as the attempt) — ONLY the
    //       invigilation fields their UIs actually write: freeze/unfreeze
    //       (frozenAt, frozenBy, frozenReason, totalFrozenSeconds), soft-delete
    //       (isDeleted), and updatedAt. Scores, gradedAnswers, answers and
    //       status are staff-immutable at this layer — grading flows ONLY
    //       through the gradeAttempt / regradeAttempts Cloud Functions, for
    //       every role. Frozen state is frozenAt != null; status is never
    //       touched by freeze. (Audit 2026-07-17, N3: without this whitelist,
    //       staff at any participating institute could silently rewrite
    //       grades on attempts of exams they don't own, e.g. webOwner-run
    //       platform exams.)
    //     • webOwner — unrestricted (platform owner; manual repair).
    //   delete: hard-blocked — soft-delete (isDeleted=true) via staff update.
    // ── Phase 2.5: sequential delivery (linear / adaptive) ──────────
    // In linear/adaptive the SERVER owns answer writes, via the
    // submitAnswerAndAdvance callable (Admin SDK → bypasses these rules).
    // A student must not be able to updateDoc an answer directly, or the
    // strict-linear lock (and the "never holds the paper" guarantee) would
    // be trivially bypassable from DevTools. Standard mode keeps its fast
    // direct client writes; legacy attempts (no securityConfig) behave as
    // standard, so nothing regresses.
    function attemptIsSequentialDelivery() {
      return 'securityConfig' in resource.data
          && 'deliveryMode' in resource.data.securityConfig
          && (resource.data.securityConfig.deliveryMode == 'linear'
              || resource.data.securityConfig.deliveryMode == 'adaptive');
    }
    function studentAnswerWriteAllowed() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['answers'])
          || !attemptIsSequentialDelivery();
    }

    // Staff (institute / faculty) invigilation whitelist — the ONLY fields
    // their client code writes (verified against submissionService.ts:
    // freezeAttempt, unfreezeAttempt, softDeleteAttempt). hasOnly() gates
    // top-level keys of the patch, same mechanism as the student whitelist.
    function staffAttemptUpdateFieldsAllowed() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'frozenAt',
        'frozenBy',
        'frozenReason',
        'totalFrozenSeconds',
        'isDeleted',
        'updatedAt'
      ]);
    }

    function studentAttemptUpdateFieldsAllowed() {
      // hasOnly() checks TOP-LEVEL keys of the patch. Dot-path writes like
      // `answers.q_xyz` or `integrityLog.tabSwitches` count as changes to the
      // top-level parent key, so this gates every legitimate direct write.
      //
      // NOTE: sectionTimings / sectionIds / currentSectionIdx are DELIBERATELY
      // excluded — all time transitions (exam start, section start/submit,
      // break) now flow through the startExam / startSection / submitSection
      // Cloud Functions (admin SDK, which bypasses these rules). A student can
      // no longer write section timings directly, so the per-section clock
      // cannot be forged from the browser.
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'answers',
        'integrityLog',
        'activeSessionId',
        'sessionConflictAt',
        'updatedAt'
      ]);
    }

    match /attempts/{id} {
      allow read: if isWebOwner()
                     || (role() == 'student'
                         && resource.data.studentId == request.auth.token.studentId)
                     || ((role() == 'institute' || role() == 'faculty')
                         && request.auth.token.instituteId == resource.data.instituteId);

      allow create: if isWebOwner();

      allow update: if isWebOwner()
                       || (role() == 'student'
                           && resource.data.studentId == request.auth.token.studentId
                           && resource.data.status == 'in_progress'
                           && request.resource.data.status == 'in_progress'
                           && studentAttemptUpdateFieldsAllowed()
                           && studentAnswerWriteAllowed())
                       || ((role() == 'institute' || role() == 'faculty')
                           && request.auth.token.instituteId == resource.data.instituteId
                           && staffAttemptUpdateFieldsAllowed());

      allow delete: if false;
    }

    match /questions/{id} {
      // Students are DENIED direct reads: published assessments expose
      // question ids, so `signedIn()` reads let any student dump the whole
      // bank's content from the console. Students receive question content
      // ONLY via the getExamQuestions Cloud Function (whitelisted fields,
      // assessment-scoped, assignment-checked).
      //
      // TENANT FENCE (permission-model Phase 0 — replaces the former SEAM
      // that let any institute/faculty read any question's content):
      // staff read = webOwner content + anything authored inside the
      // caller's OWN institute. Cross-institute content is unreadable.
      // Fine-grained "shared with me" visibility (grants / peer shares)
      // stays enforced in the service layer, exactly like grants today —
      // this wall is what rules can enforce cheaply and provably.
      //
      //   • instituteId is the tenant stamp: present on institute- and
      //     faculty-authored questions (faculty stamps carry their
      //     institute), absent on webOwner content. The backfill script
      //     stamps legacy and pre-fence docs.
      //   • legacy docs (no ownerType) read as webOwner-owned via .get().
      //   • query provability: own-bank pages filter ownerType+ownerId
      //     (own branch); grant + review batches filter
      //     ownerType=='webOwner'; peer-share batches filter
      //     instituteId==caller's. Unfiltered scans are webOwner-only.
      allow read: if isWebOwner()
                  || (role() == 'institute'
                      && (resource.data.get('ownerType', 'webOwner') == 'webOwner'
                          || resource.data.get('instituteId', '') == request.auth.token.instituteId
                          || (resource.data.get('ownerType', '') == 'institute'
                              && resource.data.get('ownerId', '') == request.auth.token.instituteId)))
                  || (role() == 'faculty'
                      && (resource.data.get('ownerType', 'webOwner') == 'webOwner'
                          || resource.data.get('instituteId', '') == request.auth.token.instituteId
                          || (resource.data.get('ownerType', '') == 'faculty'
                              && resource.data.get('ownerId', '') == request.auth.token.facultyId)));
      // Legacy questions may lack ownerType — treat as webOwner-owned.
      // Stamp validation: institute/faculty-authored docs must carry the
      // AUTHOR's own institute as instituteId (prevents planting a question
      // into another tenant's visibility); webOwner content never carries
      // one. Enforced on the FINAL doc state for both create and update
      // (updates are partial merges client-side, so backfilled stamps
      // survive edits untouched).
      allow create: if canWriteOwned(request.resource.data.ownerType,
                                     request.resource.data.ownerId)
                    && questionInstituteStampOk(request.resource.data);
      allow update: if canWriteOwned(
                          resource.data.get('ownerType', 'webOwner'),
                          resource.data.get('ownerId',   'webOwner'))
                    && questionInstituteStampOk(request.resource.data);
      allow delete: if canWriteOwned(
                          resource.data.get('ownerType', 'webOwner'),
                          resource.data.get('ownerId',   'webOwner'));
    }

    // questionAnswers/{id} — sibling collection holding correctIds /
    // correctPairs / modelAnswer for each question.
    //
    // READ — owner-scoped (was: any signed-in non-student, which let ANY
    // institute or faculty account on the platform dump EVERY answer key,
    // including other institutes' private questions and the webOwner bank):
    //   • webOwner — all keys
    //   • institute / faculty — only keys of questions they own
    //     (canWriteOwned on the answer doc's own ownerType/ownerId fields)
    //   • students — never; the gradeAttempt / regradeAttempts Cloud
    //     Functions (admin SDK, bypass rules) are the only student-facing
    //     read path, and bulk regrade also runs server-side now.
    //
    // Query provability: batched reads from the client must carry
    // where('ownerType','==',…) + where('ownerId','==',…) filters matching
    // the caller's claim (see mergeAnswers in questionBankService), or fall
    // back to per-document gets which are evaluated doc-by-doc.
    //
    // NOTE: direct field access (not .get() with a default) is deliberate —
    // it keeps owner-filtered queries provable. Legacy answer docs missing
    // ownerType/ownerId are readable by webOwner only.
    match /questionAnswers/{id} {
      allow read:   if isWebOwner()
                       || canWriteOwned(resource.data.ownerType,
                                        resource.data.ownerId);
      allow create: if canWriteOwned(request.resource.data.ownerType,
                                     request.resource.data.ownerId);
      allow update: if canWriteOwned(
                          resource.data.get('ownerType', 'webOwner'),
                          resource.data.get('ownerId',   'webOwner'));
      allow delete: if canWriteOwned(
                          resource.data.get('ownerType', 'webOwner'),
                          resource.data.get('ownerId',   'webOwner'));
    }

    // questionBanks — owned by Web Owner only (no instituteId on the doc).
    match /questionBanks/{id} {
      allow read:   if isStaff();   // L-b: students have no reason to enumerate share/grant metadata
      allow create, update, delete: if isWebOwner();
    }

    // bankGrants (Web Owner → Institute) — only Web Owner mutates.
    match /bankGrants/{id} {
      allow read:   if isStaff();   // L-b: students have no reason to enumerate share/grant metadata
      allow create, update, delete: if isWebOwner();
    }

    // instituteGrants (Institute Admin → Faculty within the same institute).
    match /instituteGrants/{id} {
      allow read:   if isStaff();   // L-b: students have no reason to enumerate share/grant metadata
      allow create: if isWebOwner()
                       || isInstituteOf(request.resource.data.instituteId);
      allow update: if isWebOwner()
                       || isInstituteOf(resource.data.instituteId);
      allow delete: if isWebOwner()
                       || isInstituteOf(resource.data.instituteId);
    }

    // questionShares — sender (institute or faculty) writes; recipient reads.
    // sharedByInstituteId must match the caller's institute claim, and
    // sharedBy must match the caller's institute/faculty id.
    function canWriteShare(d) {
      return isWebOwner()
        || (d.sharedByType == 'institute'
            && role() == 'institute'
            && request.auth.token.instituteId == d.sharedByInstituteId
            && request.auth.token.instituteId == d.sharedBy)
        || (d.sharedByType == 'faculty'
            && role() == 'faculty'
            && request.auth.token.instituteId == d.sharedByInstituteId
            && request.auth.token.facultyId   == d.sharedBy);
    }
    match /questionShares/{id} {
      allow read:   if isStaff();   // L-b: students have no reason to enumerate share/grant metadata
      allow create: if canWriteShare(request.resource.data);
      allow update: if canWriteShare(resource.data);
      allow delete: if canWriteShare(resource.data);
    }

    // questionRequests — Phase 3 request/approval workflow. Faculty raise
    // requests for actions their grant only permits in request mode; the
    // institute admin resolves them. All WRITES that matter (create the
    // request, approve/reject) go through the submitQuestionRequest /
    // resolveQuestionRequest callables, which enforce rights + execute
    // server-side; these rules just scope who can READ the queue and act as
    // a backstop on direct writes.
    //   • faculty  — read/write their OWN requests within their institute
    //   • institute admin — read/write requests inside their institute
    //   • webOwner — full
    function ownsRequest(d) {
      return isWebOwner()
        || (role() == 'institute' && request.auth.token.instituteId == d.instituteId)
        || (role() == 'faculty'
            && request.auth.token.instituteId == d.instituteId
            && request.auth.token.facultyId   == d.facultyId);
    }
    match /questionRequests/{id} {
      allow read:   if ownsRequest(resource.data);
      allow create: if ownsRequest(request.resource.data);
      allow update: if ownsRequest(resource.data);
      allow delete: if isWebOwner();
    }

    // questionReports — student files; assessment owner (institute or faculty)
    // resolves; webOwner override.
    function canResolveReport(d) {
      return isWebOwner()
        || (d.ownerType == 'institute'
            && role() == 'institute'
            && request.auth.token.instituteId == d.ownerId)
        || (d.ownerType == 'faculty'
            && role() == 'faculty'
            && request.auth.token.facultyId == d.ownerId)
        || (role() == 'institute'
            && d.instituteId is string
            && request.auth.token.instituteId == d.instituteId);
    }
    match /questionReports/{id} {
      // Read: reporters see their own; reviewers (owner/institute/faculty)
      // see reports scoped to their institute. Cross-institute read blocked.
      allow read: if isWebOwner()
                     || (role() == 'student'
                         && resource.data.studentId == request.auth.token.studentId)
                     || ((role() == 'institute' || role() == 'faculty')
                         && resource.data.instituteId is string
                         && request.auth.token.instituteId == resource.data.instituteId);
      // L-c: a student's report may not carry another institute's id (was
      // injectable noise into that institute's inbox). Tolerates absence —
      // reports on webOwner-owned exams may omit instituteId.
      allow create: if isWebOwner()
                       || (role() == 'student'
                           && request.resource.data.studentId == request.auth.token.studentId
                           && (!('instituteId' in request.resource.data)
                               || request.resource.data.instituteId == request.auth.token.instituteId));
      allow update: if canResolveReport(resource.data);
      allow delete: if isWebOwner();
    }

    // subjects — global taxonomy, Web Owner only.
    match /subjects/{id} {
      allow read:   if signedIn();
      allow create, update, delete: if isWebOwner();
    }

    // topics — child of subjects (subjectId field), Web Owner only.
    match /topics/{id} {
      allow read:   if signedIn();
      allow create, update, delete: if isWebOwner();
    }

    // enrollments — RETIRED (L-a, 2026-07-17). Zero client callers remain;
    // membership went to assessmentMembers (rules mode) / assignedTo (legacy).
    // Explicit deny kept as a tombstone so a stray write fails loudly here
    // rather than falling through to the default.
    match /enrollments/{id} {
      allow read, write: if false;
    }

    // ═════════════════════════════════════════════════════════════════════════
    // ALLOCATION SYSTEM (Phase B — plans/ALLOCATION_SYSTEM_PLAN.md)
    // All three collections are written EXCLUSIVELY by Cloud Functions via the
    // Admin SDK (which bypasses these rules). Every client write is denied —
    // including the Web Owner's. That is the design, not an oversight:
    // membership may only change through resolveAllocation / addManualMember
    // so that every change is validated, versioned, and audited.
    // ═════════════════════════════════════════════════════════════════════════

    // allocations/{assessmentId} — the allocation definition + summaries.
    match /allocations/{assessmentId} {
      allow read:  if isWebOwner();
      allow write: if false;
    }

    // assessmentMembers/{assessmentId_studentId} — the materialized list.
    // Students may read ONLY their own membership docs — this is what powers
    // the dashboard's "which exams am I allocated to?" query (Phase C).
    match /assessmentMembers/{id} {
      allow read:  if isWebOwner()
                      || (role() == 'student'
                          && resource.data.studentId == request.auth.token.studentId);
      allow write: if false;
    }

    // allocationAudit/{autoId} — append-only history. Immutable to EVERY
    // client principal, including the Web Owner: there is nothing to edit.
    match /allocationAudit/{id} {
      allow read:  if isWebOwner();
      allow write: if false;
    }

    // ═════════════════════════════════════════════════════════════════════════
    // ENTITY LIFECYCLE (Feature #15, Phase 0b)
    // ═════════════════════════════════════════════════════════════════════════

    // deletionAudit/{autoId} — append-only lifecycle trail: archive, soft
    // delete, restore, purge, and (Phase 4) request submissions/resolutions.
    //
    // IMMUTABLE TO EVERY CLIENT PRINCIPAL, INCLUDING THE WEB OWNER.
    // Same posture as allocationAudit above, for the same reason plus a
    // stronger one: an audit trail a client can write is one a client can
    // FORGE, and an audit trail a client writes separately from the action
    // is one that can silently go missing when the second call fails. Rows
    // are written server-side by the same callable that performs the
    // transition, inside the same operation.
    //
    // READ SCOPING
    //   • webOwner  — the whole trail.
    //   • institute — only rows stamped with its own instituteId. Provable
    //     from the query: the client filters instituteId == own claim (see
    //     getAuditForInstitute in src/lib/deletionAudit.ts), so this rule
    //     never forces an unfiltered scan.
    //   • faculty / student — nothing. Faculty may TRIGGER lifecycle actions
    //     under Phase 3 rights, but the trail exists to hold actors
    //     accountable, so it is not readable by the population it audits.
    match /deletionAudit/{id} {
      allow read:  if isWebOwner()
                      || (signedIn()
                          && role() == 'institute'
                          && resource.data.instituteId == request.auth.token.instituteId);
      allow write: if false;
    }

    // deletionRequests/{autoId} — the two-hop approval workflow (Phase 4).
    //
    //   faculty  (mode 'request')      → institute admin approves
    //   institute(selfMode 'request')  → Web Owner approves
    //
    // READS are scoped so each party sees exactly their own slice:
    //   • webOwner  — everything (they are the approver for institute-raised
    //     requests, and oversee the rest).
    //   • institute — every request in their own tenant: the ones their
    //     faculty raised to them, AND the ones they raised upward, so a
    //     single inbox shows both sides of their position in the chain.
    //   • faculty   — only requests they raised themselves.
    //
    // WRITES are server-only, permanently. submitDeletionRequest and
    // resolveDeletionRequest are callables because the server must (a) verify
    // the requester actually holds the right in request mode, (b) re-check the
    // APPROVER's rights at execution time rather than submission time, and
    // (c) EXECUTE the deletion itself. A client-writable status field would
    // let a requester approve their own request.
    function ownsDeletionRequest(d) {
      return isWebOwner()
        || (role() == 'institute' && request.auth.token.instituteId == d.instituteId)
        || (role() == 'faculty'
            && request.auth.token.instituteId == d.instituteId
            && request.auth.uid == d.requesterUid);
    }
    match /deletionRequests/{id} {
      allow read:  if signedIn() && ownsDeletionRequest(resource.data);
      allow write: if false;
    }

    // subjectRequests/{autoId} — access & erasure requests (Feature #15, 7b).
    //
    // The record of who asked for their data, when they asked, and what was
    // decided — including refusals, which are as much a compliance artifact as
    // fulfilments. Reads mirror deletionRequests: webOwner everything,
    // institute its own tenant, nobody else.
    //
    // Students and faculty cannot read these, deliberately. A subject request
    // is staff correspondence ABOUT a person, not a surface FOR them; a
    // self-service view would need its own identity checks and its own
    // decisions about what a subject may see of an internal deliberation.
    //
    // Writes are server-only permanently. submitSubjectRequest and
    // decideSubjectRequest are callables so that the server can enforce the
    // duplicate-open-request rule, require a reason on refusal, and stop an
    // institute marking an ERASURE fulfilled when only the Web Owner can
    // carry one out.
    match /subjectRequests/{id} {
      allow read:  if isWebOwner()
                      || (signedIn()
                          && role() == 'institute'
                          && resource.data.instituteId == request.auth.token.instituteId);
      allow write: if false;
    }

    // ═════════════════════════════════════════════════════════════════════════
    // BLOCKED — leftover dev/test collections
    // ═════════════════════════════════════════════════════════════════════════
    match /connectionTest/{id}        { allow read, write: if false; }
    match /firebaseConnectionTest/{id}{ allow read, write: if false; }

    // Anything not explicitly matched above falls through to the default deny.
  }
}
