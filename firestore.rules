rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════════
// STRATUM — Firestore Security Rules
// ═══════════════════════════════════════════════════════════════════════════════
//
// ARCHITECTURE NOTE
// ─────────────────
// STRATUM uses custom credential authentication (passwords stored in Firestore,
// compared in the browser) rather than Firebase Authentication. This means
// request.auth is always null — rules cannot verify which role is logged in.
//
// What these rules DO enforce:
//   ✅  Only the 19 known collections are accessible — all others are denied
//   ✅  Every write is validated against the expected document schema
//   ✅  Enum fields (status, validityType, role) are constrained to legal values
//   ✅  Required string fields must be non-empty
//   ✅  Boolean fields must be booleans (not strings or numbers)
//   ✅  webowners documents cannot be deleted from the browser client
//   ✅  Logo documents are capped at Firestore's 1 MB document limit
//
// What these rules CANNOT enforce (without Firebase Auth):
//   ❌  Proving the writer is a logged-in Web Owner before mutating institutes
//   ❌  Scoping institute admins to their own records only
//   ❌  Preventing a rogue client from reading any credential document
//
// PATH TO FULL SECURITY
// ─────────────────────
// Migrating to Firebase Authentication would let you add `request.auth != null`
// and custom claims (role, instituteId) to every rule, providing true
// role-isolated access control. Until then, these structural rules are the
// strongest defence available to a client-auth-only Firestore setup.
//
// Firebase App Check (https://firebase.google.com/docs/app-check) is the other
// layer to add: it ensures only YOUR web app can call Firestore at all, blocking
// raw API abuse even without Firebase Auth.
//
// ═══════════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────

    // True when val is a non-empty string
    function str(val) {
      return val is string && val.size() > 0;
    }

    // True when val is a boolean
    function bool(val) {
      return val is bool;
    }

    // True when val is an integer ≥ 0
    function nat(val) {
      return val is int && val >= 0;
    }

    // True when a field key exists in the incoming document
    function has(field) {
      return field in request.resource.data;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // webowners/{email}
    //
    // Document ID = the web owner's email address.
    // Fields: email, name, password, resetCode? (string), resetExpiry? (string)
    //
    // Reads:  public — needed to verify login from the browser
    // Create: allowed with strict structural validation
    // Update: allowed; resetCode / resetExpiry are optional
    // Delete: BLOCKED — the web owner record must not be erasable from a client
    // ─────────────────────────────────────────────────────────────────────────
    match /webowners/{email} {
      allow read: if true;

      allow create: if
        str(request.resource.data.email) &&
        str(request.resource.data.name) &&
        str(request.resource.data.password) &&
        // Ensure the email field inside the doc matches the document ID
        request.resource.data.email == email &&
        // Reject any extra fields beyond the six known ones
        request.resource.data.keys().hasOnly(
          ['email', 'name', 'password', 'resetCode', 'resetExpiry']
        );

      allow update: if
        str(request.resource.data.email) &&
        str(request.resource.data.name) &&
        str(request.resource.data.password) &&
        request.resource.data.email == email &&
        request.resource.data.keys().hasOnly(
          ['email', 'name', 'password', 'resetCode', 'resetExpiry']
        );

      // Hard block — protects the sole admin account from client-side deletion
      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // institutes/{instituteId}
    //
    // Document ID = UUID generated by the Web Owner dashboard.
    // Fields: id, name, code, adminName, adminEmail, status, validityType,
    //         activeUntil, firstLoginRequired, createdAt, updatedAt
    // ─────────────────────────────────────────────────────────────────────────
    match /institutes/{instituteId} {
      allow read: if true;

      allow create, update: if
        str(request.resource.data.id) &&
        str(request.resource.data.name) &&
        str(request.resource.data.code) &&
        str(request.resource.data.adminName) &&
        str(request.resource.data.adminEmail) &&
        // status must be one of the two legal values
        request.resource.data.status in ['active', 'disabled'] &&
        // validityType must be one of the three legal values
        request.resource.data.validityType in ['monthly', 'yearly', 'custom'] &&
        str(request.resource.data.activeUntil) &&
        bool(request.resource.data.firstLoginRequired) &&
        str(request.resource.data.createdAt) &&
        str(request.resource.data.updatedAt);

      allow delete: if true;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // instituteCredentials/{instituteId}
    //
    // Parallel to institutes — keyed by the same UUID.
    // Fields: instituteId, email, password, firstLoginRequired
    // ─────────────────────────────────────────────────────────────────────────
    match /instituteCredentials/{instituteId} {
      allow read: if true;

      allow create, update: if
        str(request.resource.data.instituteId) &&
        str(request.resource.data.email) &&
        str(request.resource.data.password) &&
        bool(request.resource.data.firstLoginRequired);

      allow delete: if true;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // instituteLogos/{instituteId}
    //
    // Stores a base64-encoded dataUrl for the institute's logo.
    // Firestore's hard 1 MB document limit already caps the image size, but we
    // enforce it explicitly in the rule as an extra guard.
    // Fields: dataUrl (base64 string), updatedAt (ISO string)
    // ─────────────────────────────────────────────────────────────────────────
    match /instituteLogos/{instituteId} {
      allow read: if true;

      allow create, update: if
        str(request.resource.data.dataUrl) &&
        str(request.resource.data.updatedAt) &&
        // Firestore max doc size is 1 048 487 bytes; enforce a 950 kB limit on
        // the dataUrl field to leave headroom for the rest of the document.
        request.resource.data.dataUrl.size() <= 950000;

      allow delete: if true;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // instituteConfigs/{instituteId}
    //
    // Internal operational metadata set by the platform.
    // Fields: instituteId, boundaryCreatedAt (string|null), facultyCount (int),
    //         studentCount (int)
    // ─────────────────────────────────────────────────────────────────────────
    match /instituteConfigs/{instituteId} {
      allow read: if true;

      allow create, update: if
        str(request.resource.data.instituteId) &&
        nat(request.resource.data.facultyCount) &&
        nat(request.resource.data.studentCount);

      allow delete: if true;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // faculty/{facultyId}
    //
    // Document ID = UUID generated on creation.
    // Fields: id, instituteId, name, email, role, status,
    //         firstLoginRequired, createdAt, updatedAt
    // ─────────────────────────────────────────────────────────────────────────
    match /faculty/{facultyId} {
      allow read: if true;

      allow create, update: if
        str(request.resource.data.id) &&
        str(request.resource.data.instituteId) &&
        str(request.resource.data.name) &&
        str(request.resource.data.email) &&
        // role is fixed — only 'Faculty' is legal in this collection
        request.resource.data.role == 'Faculty' &&
        request.resource.data.status in ['active', 'disabled'] &&
        bool(request.resource.data.firstLoginRequired) &&
        str(request.resource.data.createdAt) &&
        str(request.resource.data.updatedAt);

      allow delete: if true;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // facultyCredentials/{facultyId}
    //
    // Parallel to faculty — keyed by the same UUID.
    // Fields: facultyId, email, password, firstLoginRequired
    // ─────────────────────────────────────────────────────────────────────────
    match /facultyCredentials/{facultyId} {
      allow read: if true;

      allow create, update: if
        str(request.resource.data.facultyId) &&
        str(request.resource.data.email) &&
        str(request.resource.data.password) &&
        bool(request.resource.data.firstLoginRequired);

      allow delete: if true;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // students/{studentId}
    //
    // Document ID = UUID generated on creation.
    // Fields: id, instituteId, name, email, role, status, firstLoginRequired,
    //         createdAt, updatedAt
    // Optional arrays: group, section, specialisation, program, degreeLevel, school
    // ─────────────────────────────────────────────────────────────────────────
    match /students/{studentId} {
      allow read: if true;

      allow create, update: if
        str(request.resource.data.id) &&
        str(request.resource.data.instituteId) &&
        str(request.resource.data.name) &&
        str(request.resource.data.email) &&
        // role is fixed — only 'Student' is legal in this collection
        request.resource.data.role == 'Student' &&
        request.resource.data.status in ['active', 'disabled'] &&
        bool(request.resource.data.firstLoginRequired) &&
        str(request.resource.data.createdAt) &&
        str(request.resource.data.updatedAt);

      allow delete: if true;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // studentCredentials/{studentId}
    //
    // Parallel to students — keyed by the same UUID.
    // Fields: studentId, email, password, firstLoginRequired
    // ─────────────────────────────────────────────────────��───────────────────
    match /studentCredentials/{studentId} {
      allow read: if true;

      allow create, update: if
        str(request.resource.data.studentId) &&
        str(request.resource.data.email) &&
        str(request.resource.data.password) &&
        bool(request.resource.data.firstLoginRequired);

      allow delete: if true;
    }

    // ═════════════════════════════════════════════════════════════════════════
    // ACADEMIC HIERARCHY COLLECTIONS
    // ═════════════════════════════════════════════════════════════════════════
    //
    // Ten collections that implement the hierarchy:
    //   School → AcademicLevel → Program → AcademicSession → AcademicYear
    //   → Semester (optional) → Course → Section → Group
    //   + AcademicMapping (student ↔ node links)
    //
    // All hierarchy nodes use status 'active' | 'archived' (soft delete).
    // Hard deletes are blocked — only archiveNode() is allowed from the client.
    // Every document carries its full ancestry chain as denormalized ID fields.
    // ═════════════════════════════════════════════════════════════════════════

    // ─────────────────────────────────────────────────────────────────────────
    // schools/{schoolId}
    //
    // Top of the hierarchy. Fields: id, instituteId, name, status,
    //                               createdAt, updatedAt
    // ─────────────────────────────────────────────────────────────────────────
    match /schools/{schoolId} {
      allow read: if true;

      allow create, update: if
        str(request.resource.data.id) &&
        str(request.resource.data.instituteId) &&
        str(request.resource.data.name) &&
        request.resource.data.status in ['active', 'archived'] &&
        str(request.resource.data.createdAt) &&
        str(request.resource.data.updatedAt);

      // Hard delete is blocked — use archiveSchool() (sets status = 'archived').
      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // academicLevels/{levelId}
    //
    // UG / PG / Diploma etc.
    // Fields: id, instituteId, schoolId, name, status, createdAt, updatedAt
    // ─────────────────────────────────────────────────────────────────────────
    match /academicLevels/{levelId} {
      allow read: if true;

      allow create, update: if
        str(request.resource.data.id) &&
        str(request.resource.data.instituteId) &&
        str(request.resource.data.schoolId) &&
        str(request.resource.data.name) &&
        request.resource.data.status in ['active', 'archived'] &&
        str(request.resource.data.createdAt) &&
        str(request.resource.data.updatedAt);

      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // programs/{programId}
    //
    // B.Tech / MBA / B.Sc etc.
    // Fields: id, instituteId, schoolId, levelId, name, status,
    //         createdAt, updatedAt
    // ─────────────────────────────────────────────────────────────────────────
    match /programs/{programId} {
      allow read: if true;

      allow create, update: if
        str(request.resource.data.id) &&
        str(request.resource.data.instituteId) &&
        str(request.resource.data.schoolId) &&
        str(request.resource.data.levelId) &&
        str(request.resource.data.name) &&
        request.resource.data.status in ['active', 'archived'] &&
        str(request.resource.data.createdAt) &&
        str(request.resource.data.updatedAt);

      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // academicSessions/{sessionId}
    //
    // 2024-25 / 2025-26 etc.
    // Fields: id, instituteId, schoolId, levelId, programId, name, status,
    //         createdAt, updatedAt
    // ─────────────────────────────────────────────────────────────────────────
    match /academicSessions/{sessionId} {
      allow read: if true;

      allow create, update: if
        str(request.resource.data.id) &&
        str(request.resource.data.instituteId) &&
        str(request.resource.data.schoolId) &&
        str(request.resource.data.levelId) &&
        str(request.resource.data.programId) &&
        str(request.resource.data.name) &&
        request.resource.data.status in ['active', 'archived'] &&
        str(request.resource.data.createdAt) &&
        str(request.resource.data.updatedAt);

      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // academicYears/{yearId}
    //
    // Year 1 / Year 2 etc.
    // Fields: id, instituteId, schoolId, levelId, programId, sessionId,
    //         name, status, createdAt, updatedAt
    // ─────────────────────────────────────────────────────────────────────────
    match /academicYears/{yearId} {
      allow read: if true;

      allow create, update: if
        str(request.resource.data.id) &&
        str(request.resource.data.instituteId) &&
        str(request.resource.data.schoolId) &&
        str(request.resource.data.levelId) &&
        str(request.resource.data.programId) &&
        str(request.resource.data.sessionId) &&
        str(request.resource.data.name) &&
        request.resource.data.status in ['active', 'archived'] &&
        str(request.resource.data.createdAt) &&
        str(request.resource.data.updatedAt);

      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // semesters/{semesterId}
    //
    // Optional layer between Year and Course. A year may have zero semesters,
    // in which case courses attach directly to the year.
    // Fields: id, instituteId, schoolId, levelId, programId, sessionId,
    //         yearId, name, type ('Semester'|'Trimester'), number (int ≥ 1),
    //         status, createdAt, updatedAt
    // ─────────────────────────────────────────────────────────────────────────
    match /semesters/{semesterId} {
      allow read: if true;

      allow create, update: if
        str(request.resource.data.id) &&
        str(request.resource.data.instituteId) &&
        str(request.resource.data.schoolId) &&
        str(request.resource.data.levelId) &&
        str(request.resource.data.programId) &&
        str(request.resource.data.sessionId) &&
        str(request.resource.data.yearId) &&
        str(request.resource.data.name) &&
        request.resource.data.type in ['Semester', 'Trimester'] &&
        request.resource.data.number is int &&
        request.resource.data.number >= 1 &&
        request.resource.data.status in ['active', 'archived'] &&
        str(request.resource.data.createdAt) &&
        str(request.resource.data.updatedAt);

      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // courses/{courseId}
    //
    // Mathematics / Data Structures etc.
    // semesterId may be null (stored as the string "null" is NOT used —
    // the field is simply absent or an empty string when the course is
    // attached directly to a year; the rule allows any string or null).
    // Fields: id, instituteId, schoolId, levelId, programId, sessionId,
    //         yearId, semesterId (string|null), name, code, status,
    //         createdAt, updatedAt
    // ─────────────────────────────────────────────────────────────────────────
    match /courses/{courseId} {
      allow read: if true;

      allow create, update: if
        str(request.resource.data.id) &&
        str(request.resource.data.instituteId) &&
        str(request.resource.data.schoolId) &&
        str(request.resource.data.levelId) &&
        str(request.resource.data.programId) &&
        str(request.resource.data.sessionId) &&
        str(request.resource.data.yearId) &&
        // semesterId is either a non-empty string or null
        (request.resource.data.semesterId == null ||
         str(request.resource.data.semesterId)) &&
        str(request.resource.data.name) &&
        str(request.resource.data.code) &&
        request.resource.data.status in ['active', 'archived'] &&
        str(request.resource.data.createdAt) &&
        str(request.resource.data.updatedAt);

      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // sections/{sectionId}
    //
    // Section A / Section B etc.
    // Fields: id, instituteId, schoolId, levelId, programId, sessionId,
    //         yearId, semesterId (string|null), courseId, name, status,
    //         createdAt, updatedAt
    // ─────────────────────────────────────────────────────────────────────────
    match /sections/{sectionId} {
      allow read: if true;

      allow create, update: if
        str(request.resource.data.id) &&
        str(request.resource.data.instituteId) &&
        str(request.resource.data.schoolId) &&
        str(request.resource.data.levelId) &&
        str(request.resource.data.programId) &&
        str(request.resource.data.sessionId) &&
        str(request.resource.data.yearId) &&
        (request.resource.data.semesterId == null ||
         str(request.resource.data.semesterId)) &&
        str(request.resource.data.courseId) &&
        str(request.resource.data.name) &&
        request.resource.data.status in ['active', 'archived'] &&
        str(request.resource.data.createdAt) &&
        str(request.resource.data.updatedAt);

      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // groups/{groupId}
    //
    // Group 1 / Group 2 etc.
    // Fields: id, instituteId, schoolId, levelId, programId, sessionId,
    //         yearId, semesterId (string|null), courseId, sectionId, name,
    //         status, createdAt, updatedAt
    // ─────────────────────────────────────────────────────────────────────────
    match /groups/{groupId} {
      allow read: if true;

      allow create, update: if
        str(request.resource.data.id) &&
        str(request.resource.data.instituteId) &&
        str(request.resource.data.schoolId) &&
        str(request.resource.data.levelId) &&
        str(request.resource.data.programId) &&
        str(request.resource.data.sessionId) &&
        str(request.resource.data.yearId) &&
        (request.resource.data.semesterId == null ||
         str(request.resource.data.semesterId)) &&
        str(request.resource.data.courseId) &&
        str(request.resource.data.sectionId) &&
        str(request.resource.data.name) &&
        request.resource.data.status in ['active', 'archived'] &&
        str(request.resource.data.createdAt) &&
        str(request.resource.data.updatedAt);

      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // academicMappings/{mappingId}
    //
    // One document per (student, node) pair.
    // Multi-mapping is by design — the same student can have many documents
    // pointing to different nodes at any level of the hierarchy.
    //
    // Fields: id, instituteId, studentId, studentName, studentEmail,
    //         nodeType (NodeLevel), nodeId, nodeName, breadcrumb, createdAt
    //
    // Mappings are immutable once created (no update). Deletion is allowed
    // to support un-assigning a student from a node.
    // ─────────────────────────────────────────────────────────────────────────
    match /academicMappings/{mappingId} {
      allow read: if true;

      allow create: if
        str(request.resource.data.id) &&
        str(request.resource.data.instituteId) &&
        str(request.resource.data.studentId) &&
        str(request.resource.data.studentName) &&
        str(request.resource.data.studentEmail) &&
        // nodeType must be one of the nine legal hierarchy levels
        request.resource.data.nodeType in [
          'school', 'academicLevel', 'program', 'academicSession',
          'academicYear', 'semester', 'course', 'section', 'group'
        ] &&
        str(request.resource.data.nodeId) &&
        str(request.resource.data.nodeName) &&
        str(request.resource.data.breadcrumb) &&
        str(request.resource.data.createdAt);

      // Mappings are immutable — to change a mapping, delete and recreate.
      allow update: if false;

      // Allow deletion to support un-assigning a student.
      allow delete: if true;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // CATCH-ALL — deny everything else
    //
    // Any collection not explicitly listed above (including any typos, test
    // collections, or attacker-created paths) is completely inaccessible.
    // This is the most important rule: the absence of a match IS the deny.
    // Firestore denies by default, so no explicit deny rule is needed here —
    // simply not matching any other path achieves this automatically.
    // ─────────────────────────────────────────────────────────────────────────

  }
}