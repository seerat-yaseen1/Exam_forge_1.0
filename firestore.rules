rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════════
// STRATUM — Firestore Security Rules (Phase 6 — Firebase Auth migration)
// ═══════════════════════════════════════════════════════════════════════════════
//
// These rules assume Firebase Authentication is the source of truth.
// Every signed-in user has a custom claim payload of one of these shapes:
//
//   { role: 'webOwner' }
//   { role: 'institute', instituteId }
//   { role: 'faculty',   instituteId, facultyId }
//   { role: 'student',   instituteId, studentId }
//
// Phase 6+ (this file) — role-scoped, not merely authenticated:
//   ✅ Reads & writes require request.auth != null (public-read hole closed)
//   ✅ webowners can only be written by Web Owners; deletion always blocked
//   ✅ Credential collections (institute/faculty/student) scoped by claim
//   ✅ Assessment / question / attempt / answer-key rules scoped by owner
//      and by materialized membership (see attempts + assessments blocks)
//   ✅ Academic hierarchy + mappings reads scoped to staff / own-student
//      (Audit N8, 2026-07-17)
//   ✅ Entity-lifecycle audit trail append-only + tenant-scoped reads;
//      deletionRequests reserved and denied until Phase 4
//      (Feature #15, Phase 0b)
//   ✅ Test collections blocked; unknown paths fall through to default deny
//
// Remaining deferrals are tracked in REMEDIATION_PLAN.md, not here (so this
// header can't drift stale again): per-institute scoping of individual staff
// hierarchy reads waits on the repo split (queries need instituteId filters),
// and the legacy assignedTo path is retired with N6.
// ═══════════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return request.auth.token.role;
    }

    function isWebOwner() {
      return signedIn() && role() == 'webOwner';
    }

    // True when the caller is the Institute Admin for this institute.
    // Doc ID == claim.instituteId for institutes/credentials/logos/configs.
    function isInstituteSelf(instituteId) {
      return signedIn()
        && role() == 'institute'
        && request.auth.token.instituteId == instituteId;
    }

    // True when the caller is an Institute Admin governing the given institute.
    // Use this when checking a doc that *belongs* to an institute (faculty,
    // student, school, course, …) — pass in the doc's instituteId field.
    function isInstituteOf(instituteId) {
      return signedIn()
        && role() == 'institute'
        && request.auth.token.instituteId == instituteId;
    }

    // True when the caller is the same Faculty member as the doc.
    // Migrated faculty: claim.facultyId == legacy doc id.
    // New faculty (post createAuthUser wiring): claim.facultyId == uid.
    function isFacultySelf(facultyId) {
      return signedIn()
        && role() == 'faculty'
        && request.auth.token.facultyId == facultyId;
    }

    // True when the caller is the same Student as the doc.
    function isStudentSelf(studentId) {
      return signedIn()
        && role() == 'student'
        && request.auth.token.studentId == studentId;
    }

    // Any staff principal (non-student). Role-only conditions are provable
    // for every query shape, which is what lets Batch B scope the academic
    // collections without touching the parent-keyed client queries
    // (levels-by-school, programs-by-level, …). Full per-institute staff
    // scoping is deferred to the repo split (Batch F5), when those queries
    // gain instituteId filters — see REMEDIATION_PLAN.md.
    function isStaff() {
      return signedIn()
        && (role() == 'webOwner' || role() == 'institute' || role() == 'faculty');
    }

    function str(val) {
      return val is string && val.size() > 0;
    }


    // ─────────────────────────────────────────────────────────────────────────
    // webowners/{uid}
    //
    // Post-migration the document ID is the Firebase Auth uid (not the email).
    // Plaintext password is no longer stored — Firebase Auth holds the secret.
    // Only Web Owners may mutate; deletes remain hard-blocked.
    // ─────────────────────────────────────────────────────────────────────────
    // ── Phase 3: platform-wide SEB settings ────────────────────────
    // Holds the SEB Config Key(s). Only the webOwner may read or write them
    // from a client. Cloud Functions read via the Admin SDK (bypasses rules),
    // which is what lets the server verify a request without ever exposing
    // the keys to a student's browser — the key must stay secret, because
    // possessing it is what would let an attacker forge the SEB hash.
    match /platformSettings/{settingId} {
      allow read, write: if isWebOwner();
    }

    // ── Phase 3 Stage 4b: student-readable platform SEB info ───────
    // ONLY the non-secret half: the platform .seb file's download link and
    // name, so the briefing gate can offer the file. The Config Keys stay in
    // platformSettings/seb (webOwner-only). Splitting the doc is what lets
    // students see the link without ever being able to read the keys.
    match /publicSettings/{settingId} {
      allow read: if signedIn();
      allow write: if isWebOwner();
    }

    // ── Phase 3 Stage 4: per-assessment SEB Config Keys ────────────
    // DELIBERATELY a separate collection, NOT a field on the assessment doc:
    // assessments are student-readable, and possessing a Config Key is what
    // lets an attacker forge the SEB hash. The verification endpoint reads
    // this collection with a service account (bypasses rules); no student
    // client ever can. The (unused) Assessment.sebConfigKeys schema field is
    // retired in favour of this collection.
    match /sebAssessmentKeys/{assessmentId} {
      allow read, write: if isWebOwner();
    }

    match /webowners/{ownerId} {
      // SELF-READ BY UID is deliberate, and it fixes a bootstrap circularity.
      //
      // isWebOwner() reads request.auth.token.role, so gating the profile read
      // on it alone means: you may read your own webOwner document only if you
      // already carry the webOwner claim. Custom claims are set at account
      // creation (createUserWithRole) or by scripts/migrate-webowners.ts —
      // never on sign-in. An account that somehow lacks the claim therefore
      // cannot read its own profile, so AuthContext.loadProfile returns null,
      // so setUser(null) runs, so the route guard bounces back to the login
      // page. Password and TOTP both SUCCEED and the user still lands back at
      // the start — a permanent lockout with no self-service way out, because
      // the only fix requires Admin SDK access the locked-out person may not
      // have. Use scripts/grant-webowner-claim.ts when that is the state.
      //
      // The extra clause leaks nothing. Documents in this collection are keyed
      // by uid, so `request.auth.uid == ownerId` can only ever match the
      // caller's OWN document, and a non-webOwner's uid has no document here
      // to find. It also does not enable enumeration: an unfiltered query over
      // the collection stays unprovable and is still refused. Cross-owner
      // reads remain webOwner-only, exactly as before.
      allow read:   if isWebOwner() || (signedIn() && request.auth.uid == ownerId);
      allow create: if isWebOwner() && str(request.resource.data.email) && str(request.resource.data.name);
      // A web owner may only update their OWN doc — prevents one admin from
      // overwriting another's name / email if multi-owner is ever enabled.
      allow update: if isWebOwner() && request.auth.uid == ownerId;
      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // institutes/{instituteId}
    // Read: webOwner (management UI, list queries), or any member of THAT
    //       institute — every auth context reads its own institute doc by id
    //       from the claim, so per-doc gets stay provable. The previous
    //       signedIn() read exposed the full institute directory (names,
    //       codes, admin emails, activeUntil) to every student on the
    //       platform. Code→institute lookups for password reset no longer
    //       exist client-side (reset is email-based, unauthenticated-safe).
    // ─────────────────────────────────────────────────────────────────────────
    match /institutes/{instituteId} {
      allow read:   if isWebOwner()
                       || (signedIn() && request.auth.token.instituteId == instituteId);
      allow create: if isWebOwner();
      // C1 (audit 2026-08-06): WEBOWNER ONLY. `isInstituteSelf(instituteId)`
      // used to sit on this line with no field whitelist, which made this
      // document self-governing — the institute admin could write ANY field on
      // the doc that governs them. Three separate escalations came out of that
      // one clause:
      //
      //   SELF-REINSTATEMENT. `status` and `activeUntil` are the lifecycle
      //   gates, and they are checked NOWHERE in these rules — `activeUntil`
      //   appears in this file exactly once, in the read comment above. The
      //   only enforcement was client-side, at InstituteAuthContext:88,
      //   FacultyAuthContext:106 and StudentAuthContext:143. Disabling an
      //   institute (UserManagementPage:598) is a bare updateDoc that does not
      //   touch Firebase Auth — no updateUser({disabled}), no
      //   revokeRefreshTokens — so a disabled or expired admin still holds a
      //   valid token carrying role:'institute' + instituteId, which is
      //   precisely what isInstituteSelf accepts. One updateDoc from the
      //   console outside the UI restored their own access.
      //
      //   QUESTION-RIGHTS ESCALATION. assertQuestionRight (index.ts:9129)
      //   reads `questionRightsCeiling` straight off this doc. A structurally
      //   correct server-side check validating attacker-controlled input.
      //
      //   DELETION-RIGHTS ESCALATION. Same shape at index.ts:1903, :2309 and
      //   :2453, all reading `deletionRightsCeiling` off this doc. Bounded by
      //   WEBOWNER_ONLY_S (index.ts:371) — 'attempt' and 'institute' are
      //   forced off regardless of the document — so attempts, and therefore
      //   the exam audit trail, were never reachable this way. Faculty and
      //   student deletion were.
      //
      // NO FIELD WHITELIST IS NEEDED HERE, because no legitimate write exists
      // to whitelist. Verified exhaustively before locking: every writer of
      // this collection in src/ is a Web Owner surface — updateInstitute is
      // called only from UserManagementPage, and all ten governance setters
      // (firebaseService:1319-1481) only from InstituteDetailPage and the two
      // ceiling editors it renders. The institute admin's own surfaces write
      // instituteLogos and instituteCredentials, never this document; the
      // three auth contexts only getDoc it. lifecycleService goes through
      // callables. Institute self-service, if it is ever wanted, belongs in a
      // callable that can re-check the lifecycle it is subject to.
      allow update: if isWebOwner();
      // LOCKED (Feature #15, Phase 6b). Client deletes are gone: every
      // removal now goes through the deleteAuthUser / purgeEntity callables,
      // which enforce the deletion-rights ceiling, write the audit row and
      // run the cascade. A client-side delete would bypass all three.
      // Verified before locking: no call site in src/ deletes these
      // collections directly (deleteInstitute was imported but never called).
      allow delete: if false;
    }

    // instituteCredentials — only holds firstLoginRequired + migration
    // metadata post-migration. Read: webOwner + the institute itself (the
    // auth context's own per-doc get). Was signedIn() — cross-tenant
    // metadata leak.
    match /instituteCredentials/{instituteId} {
      allow read:   if isWebOwner() || isInstituteSelf(instituteId);
      allow create: if isWebOwner();
      // H1 (audit 2026-08-06): the identical unwhitelisted shape as
      // institutes:161 sat here, on a credentials collection. Unlike that one
      // this collection DOES have a legitimate institute-role write, so it
      // gets a real whitelist rather than a lock.
      //
      // `firstLoginRequired` is the whole list. InstituteAuthContext:220 is
      // the only institute-role writer in the codebase — it clears the flag
      // after a successful forced password change — and it is the only field
      // that write touches. The `password`/`email` fields still declared on
      // the InstituteCredentials type are vestigial: nothing reads this
      // document for authentication (getInstituteCredentials has zero callers
      // platform-wide), so leaving them writable bought nothing and let an
      // admin scribble over their own migration metadata.
      //
      // hasOnly() gates top-level keys, same mechanism as the attempts
      // whitelists at :680 and :717.
      allow update: if isWebOwner()
                       || (isInstituteSelf(instituteId)
                           && request.resource.data.diff(resource.data)
                                .affectedKeys().hasOnly(['firstLoginRequired']));
      // LOCKED (Feature #15, Phase 6b). Client deletes are gone: every
      // removal now goes through the deleteAuthUser / purgeEntity callables,
      // which enforce the deletion-rights ceiling, write the audit row and
      // run the cascade. A client-side delete would bypass all three.
      // Verified before locking: no call site in src/ deletes these
      // collections directly (deleteInstitute was imported but never called).
      allow delete: if false;
    }

    // Logo upload: institute admin manages own; webOwner override; structural
    // validation kept from Phase 6a.
    match /instituteLogos/{instituteId} {
      allow read:   if signedIn();
      allow create, update: if (isWebOwner() || isInstituteSelf(instituteId)) &&
        str(request.resource.data.dataUrl) &&
        str(request.resource.data.updatedAt) &&
        request.resource.data.dataUrl.size() <= 950000;
      allow delete: if isWebOwner();
    }

    // instituteConfigs — collection has no callers in app code. Lock to
    // webOwner only so a stray client write can't repopulate it.
    match /instituteConfigs/{instituteId} {
      allow read:   if signedIn();
      allow create, update, delete: if isWebOwner();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // faculty / facultyCredentials
    //
    // Writers:
    //   • webOwner  — anywhere
    //   • institute — only for faculty whose instituteId matches caller's claim
    //   • faculty   — self-update only (e.g. flipping firstLoginRequired=false)
    //
    // Credentials docs don't carry instituteId, so we resolve the parent
    // faculty doc via get() to authorise institute-admin writes. This adds one
    // extra doc read per credentials write (acceptable — written rarely).
    // ─────────────────────────────────────────────────────────────────────────
    match /faculty/{facultyId} {
      allow read:   if isWebOwner()
                       || isFacultySelf(facultyId)
                       || ((role() == 'institute' || role() == 'faculty')
                           && request.auth.token.instituteId == resource.data.instituteId);
      allow create: if isWebOwner()
                       || isInstituteOf(request.resource.data.instituteId);
      // N4: isFacultySelf removed from update — no client code self-writes
      // the profile doc (contexts write facultyCredentials only), and the
      // clause let any faculty member set canCreateStudents on themselves.
      allow update: if isWebOwner()
                       || isInstituteOf(resource.data.instituteId);
      // LOCKED (Feature #15, Phase 6b). Client deletes are gone: every
      // removal now goes through the deleteAuthUser / purgeEntity callables,
      // which enforce the deletion-rights ceiling, write the audit row and
      // run the cascade. A client-side delete would bypass all three.
      // Verified before locking: no call site in src/ deletes these
      // collections directly (deleteInstitute was imported but never called).
      allow delete: if false;
    }

    match /facultyCredentials/{facultyId} {
      // Read: webOwner, the faculty member themself (auth context's own
      // per-doc get), or their institute admin (resolved via the parent
      // faculty doc, mirroring the create/update clauses). Was signedIn().
      allow read:   if isWebOwner()
                       || isFacultySelf(facultyId)
                       || (
                            exists(/databases/$(database)/documents/faculty/$(facultyId))
                            && isInstituteOf(get(/databases/$(database)/documents/faculty/$(facultyId)).data.instituteId)
                          );
      allow create: if isWebOwner()
                       || (
                            exists(/databases/$(database)/documents/faculty/$(facultyId))
                            && isInstituteOf(get(/databases/$(database)/documents/faculty/$(facultyId)).data.instituteId)
                          );
      allow update: if isWebOwner()
                       || isFacultySelf(facultyId)
                       || (
                            exists(/databases/$(database)/documents/faculty/$(facultyId))
                            && isInstituteOf(get(/databases/$(database)/documents/faculty/$(facultyId)).data.instituteId)
                          );
      // LOCKED (Feature #15, Phase 6b). Client deletes are gone: every
      // removal now goes through the deleteAuthUser / purgeEntity callables,
      // which enforce the deletion-rights ceiling, write the audit row and
      // run the cascade. A client-side delete would bypass all three.
      // Verified before locking: no call site in src/ deletes these
      // collections directly (deleteInstitute was imported but never called).
      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // students / studentCredentials
    //
    // Writers:
    //   • webOwner  — anywhere
    //   • institute — only for students whose instituteId matches caller's claim
    //   • faculty   — only for students in the same institute (faculty's
    //                 individual canCreateStudents gate is enforced app-side)
    //   • student   — self-update only
    // ─────────────────────────────────────────────────────────────────────────
    match /students/{studentId} {
      allow read:   if isWebOwner()
                       || isStudentSelf(studentId)
                       || ((role() == 'institute' || role() == 'faculty')
                           && request.auth.token.instituteId == resource.data.instituteId);
      allow create: if isWebOwner()
                       || isInstituteOf(request.resource.data.instituteId)
                       || (role() == 'faculty'
                           && request.auth.token.instituteId == request.resource.data.instituteId);
      allow update: if isWebOwner()
                       || isInstituteOf(resource.data.instituteId)
                       || (role() == 'faculty'
                           && request.auth.token.instituteId == resource.data.instituteId);
      // N4: isStudentSelf removed from update — no client code self-writes
      // the profile doc (contexts write studentCredentials only), and the
      // clause let a disabled student flip their own status back to active.
      // LOCKED (Feature #15, Phase 6b). Client deletes are gone: every
      // removal now goes through the deleteAuthUser / purgeEntity callables,
      // which enforce the deletion-rights ceiling, write the audit row and
      // run the cascade. A client-side delete would bypass all three.
      // Verified before locking: no call site in src/ deletes these
      // collections directly (deleteInstitute was imported but never called).
      allow delete: if false;
    }

    match /studentCredentials/{studentId} {
      // Read: webOwner, the student themself, or institute/faculty of that
      // student's institute (resolved via the parent student doc, mirroring
      // the create/update clauses). Was signedIn().
      allow read:   if isWebOwner()
                       || isStudentSelf(studentId)
                       || (
                            exists(/databases/$(database)/documents/students/$(studentId))
                            && (
                                 isInstituteOf(get(/databases/$(database)/documents/students/$(studentId)).data.instituteId)
                                 || (role() == 'faculty'
                                     && request.auth.token.instituteId == get(/databases/$(database)/documents/students/$(studentId)).data.instituteId)
                               )
                          );
      allow create: if isWebOwner()
                       || (
                            exists(/databases/$(database)/documents/students/$(studentId))
                            && (
                                 isInstituteOf(get(/databases/$(database)/documents/students/$(studentId)).data.instituteId)
                                 || (role() == 'faculty'
                                     && request.auth.token.instituteId == get(/databases/$(database)/documents/students/$(studentId)).data.instituteId)
                               )
                          );
      allow update: if isWebOwner()
                       || isStudentSelf(studentId)
                       || (
                            exists(/databases/$(database)/documents/students/$(studentId))
                            && (
                                 isInstituteOf(get(/databases/$(database)/documents/students/$(studentId)).data.instituteId)
                                 || (role() == 'faculty'
                                     && request.auth.token.instituteId == get(/databases/$(database)/documents/students/$(studentId)).data.instituteId)
                               )
                          );
      // LOCKED (Feature #15, Phase 6b). Client deletes are gone: every
      // removal now goes through the deleteAuthUser / purgeEntity callables,
      // which enforce the deletion-rights ceiling, write the audit row and
      // run the cascade. A client-side delete would bypass all three.
      // Verified before locking: no call site in src/ deletes these
      // collections directly (deleteInstitute was imported but never called).
      allow delete: if false;
    }

    // ═════════════════════════════════════════════════════════════════════════
    // ACADEMIC HIERARCHY
    //
    // Every doc in these collections carries `instituteId`. Writes require:
    //   • webOwner, OR
    //   • institute admin / faculty whose claim instituteId matches the doc's.
    //
    // Hard-deletes are blocked everywhere except academicMappings, which is
    // how a student gets unassigned from a node.
    // ═════════════════════════════════════════════════════════════════════════

    function canWriteAcademic(instituteId) {
      return signedIn()
        && (role() == 'webOwner'
            || ((role() == 'institute' || role() == 'faculty')
                && request.auth.token.instituteId == instituteId));
    }

    match /schools/{id} {
      allow read:   if isStaff();   // N8: students read node names via their denormalized academicMappings, never these collections
      allow create: if canWriteAcademic(request.resource.data.instituteId);
      allow update: if canWriteAcademic(resource.data.instituteId);
      allow delete: if false;
    }
    match /academicLevels/{id} {
      allow read:   if isStaff();   // N8: students read node names via their denormalized academicMappings, never these collections
      allow create: if canWriteAcademic(request.resource.data.instituteId);
      allow update: if canWriteAcademic(resource.data.instituteId);
      allow delete: if false;
    }
    match /programs/{id} {
      allow read:   if isStaff();   // N8: students read node names via their denormalized academicMappings, never these collections
      allow create: if canWriteAcademic(request.resource.data.instituteId);
      allow update: if canWriteAcademic(resource.data.instituteId);
      allow delete: if false;
    }
    match /academicSessions/{id} {
      allow read:   if isStaff();   // N8: students read node names via their denormalized academicMappings, never these collections
      allow create: if canWriteAcademic(request.resource.data.instituteId);
      allow update: if canWriteAcademic(resource.data.instituteId);
      allow delete: if false;
    }
    match /academicYears/{id} {
      allow read:   if isStaff();   // N8: students read node names via their denormalized academicMappings, never these collections
      allow create: if canWriteAcademic(request.resource.data.instituteId);
      allow update: if canWriteAcademic(resource.data.instituteId);
      allow delete: if false;
    }
    match /semesters/{id} {
      allow read:   if isStaff();   // N8: students read node names via their denormalized academicMappings, never these collections
      allow create: if canWriteAcademic(request.resource.data.instituteId);
      allow update: if canWriteAcademic(resource.data.instituteId);
      allow delete: if false;
    }
    match /courses/{id} {
      allow read:   if isStaff();   // N8: students read node names via their denormalized academicMappings, never these collections
      allow create: if canWriteAcademic(request.resource.data.instituteId);
      allow update: if canWriteAcademic(resource.data.instituteId);
      allow delete: if false;
    }
    match /sections/{id} {
      allow read:   if isStaff();   // N8: students read node names via their denormalized academicMappings, never these collections
      allow create: if canWriteAcademic(request.resource.data.instituteId);
      allow update: if canWriteAcademic(resource.data.instituteId);
      allow delete: if false;
    }
    match /groups/{id} {
      allow read:   if isStaff();   // N8: students read node names via their denormalized academicMappings, never these collections
      allow create: if canWriteAcademic(request.resource.data.instituteId);
      allow update: if canWriteAcademic(resource.data.instituteId);
      allow delete: if false;
    }
    match /academicMappings/{id} {
      // N8: was signedIn() — any student could enumerate every institute's
      // student→node directory. Students keep reading their OWN mappings
      // (profile + landing pages query where studentId == claim; provable).
      allow read:   if isStaff()
                       || (role() == 'student'
                           && resource.data.studentId == request.auth.token.studentId);
      allow create: if canWriteAcademic(request.resource.data.instituteId);
      allow update: if false;     // mappings are immutable
      allow delete: if canWriteAcademic(resource.data.instituteId);
    }

    // ═════════════════════════════════════════════════════════════════════════
    // ASSESSMENT / EXAM DATA
    // ═════════════════════════════════════════════════════════════════════════
    // Owned content (assessments / questions) — writer must match the doc's
    // ownerType + ownerId. webOwner is always allowed.
    //   ownerType ∈ {'webOwner', 'institute', 'faculty'}
    //   ownerId   ∈ {'webOwner', instituteId, facultyId}
    function canWriteOwned(ownerType, ownerId) {
      return isWebOwner()
        || (ownerType == 'institute' && role() == 'institute'
            && request.auth.token.instituteId == ownerId)
        || (ownerType == 'faculty'   && role() == 'faculty'
            && request.auth.token.facultyId == ownerId);
    }

    // questionInstituteStampOk was retired here (audit S-02). It validated
    // that institute/faculty content carried the writer's own institute and
    // webOwner content carried none — but it only ever guarded the question
    // write rules, and those are now webOwner-only, so nothing referenced it.
    //
    // The invariant did not go away; it moved somewhere stronger. The
    // *AsRole callables assign ownerType, ownerId and instituteId from the
    // caller's verified claims and ignore whatever the client sent, so the
    // stamp is now correct BY CONSTRUCTION rather than merely validated after
    // the fact.
    //
    // Deliberately NOT reapplied to the webOwner rule: it demands
    // `instituteId == request.auth.token.instituteId` for any non-webOwner
    // doc, and a webOwner has no instituteId claim — so adding it would deny
    // the webOwner every write to institute- or faculty-authored questions.

    // Is this student actually assigned to assessment `id`? Mirrors the split
    // startExam / getExamQuestions / getStudentAssessments all use: under
    // allocationMode 'rules' the materialized membership doc is authoritative
    // and assignedTo is stale by design (resolveAllocation never clears it),
    // so consulting assignedTo for a rules-mode exam would readmit exactly the
    // leak this is closing — those docs commonly carry assignedTo.type 'all'.
    //
    // Uses exists(), which costs one document access. That is affordable here
    // ONLY because this predicate is reachable from `allow get` alone: a
    // single-document request carries a budget of 10 accesses. It must never
    // be moved onto a list rule, where the budget is shared across the whole
    // result set and a large page would blow it.
    function studentAssignedToAssessment(id, d) {
      return d.get('allocationMode', '') == 'rules'
        ? exists(/databases/$(database)/documents/assessmentMembers/$(id + '_' + request.auth.token.studentId))
        : (!('assignedTo' in d)
           || d.assignedTo.type == 'all'
           || (d.assignedTo.type == 'institutes'
               && request.auth.token.instituteId in d.assignedTo.instituteIds)
           || (d.assignedTo.type == 'students'
               && request.auth.token.studentId in d.assignedTo.studentIds));
    }

    match /assessments/{id} {
      // Read access:
      //   • webOwner — always (owns all content)
      //   • institute / faculty — their OWN assessments in any status
      //     (canWriteOwned; owners must be able to read back their drafts to
      //     edit and publish them — the previous `status != 'draft'` clause
      //     made drafts unreadable to their own creators AND was unprovable
      //     for the list queries, so every institute/faculty listing query was
      //     rejected wholesale), PLUS published assessments assigned to their
      //     institute (assignedTo.type == 'all', or their instituteId in
      //     assignedTo.instituteIds).
      //   • student — NO list access at all, and single-doc get only for an
      //     assessment they are actually assigned to. See the second allow
      //     statement below.
      //
      // Query provability notes (keep queries and rule in sync):
      //   owner listing     → where ownerType==, ownerId==        (provable)
      //   assigned-to-all   → where assignedTo.type=='all',
      //                        status=='active'|'closed'          (provable)
      //   assigned-to-mine  → where assignedTo.instituteIds
      //                        array-contains <claim instituteId>,
      //                        status=='active'|'closed'          (provable)
      allow read: if isWebOwner()
                     || ((role() == 'institute' || role() == 'faculty')
                         && canWriteOwned(resource.data.ownerType, resource.data.ownerId))
                     || ((role() == 'institute' || role() == 'faculty')
                         && resource.data.status in ['active', 'closed']
                         && (resource.data.assignedTo.type == 'all'
                             || (resource.data.assignedTo.type == 'institutes'
                                 && request.auth.token.instituteId in resource.data.assignedTo.instituteIds)));

      // ── Students (audit 2026-07-26, S-04) ──────────────────────────
      // `get`, never `list`. Rule statements are additive, so this grants
      // students single-document reads WITHOUT reopening list on the branches
      // above — and without restating those branches, which duplication would
      // eventually drift.
      //
      // What this closes: the student branch used to sit inside `allow read`
      // gated on nothing but `status in ['active','closed']`. Any signed-in
      // student could therefore enumerate every published assessment on the
      // platform and read its title, schedule, blueprint, pass mark, question
      // ids and the ids of every blocked student — at other institutes
      // included. That enumeration is how a target for the S-01 paper download
      // was found in the first place.
      //
      // Students no longer list this collection at all; their dashboard is
      // served by the getStudentAssessments callable, which resolves
      // visibility server-side and strips other students' ids before
      // returning. The three remaining single-doc reads (ExamShell,
      // ExamBriefingPage, ExamResultsPage) are what this `get` serves, and
      // each is for an exam the student is entering or reviewing.
      allow get: if role() == 'student'
                    && resource.data.status in ['active', 'closed']
                    && studentAssignedToAssessment(id, resource.data);
      // P-01 / "no compromise": an assessment may not become live without its
      // security config frozen. The stamp is set client-side by
      // assessmentService.stampIfPublishing, but a client-side convention is
      // not enforcement — this clause is what makes publishing without a lock
      // impossible, including from the console.
      //
      // Scoped to the TRANSITION into 'active', not to every write on a live
      // doc. Assessments published before this rule existed have no stamp, and
      // gating all their updates on one would freeze schedule and access edits
      // on exams that are already running. Those get stamped lazily by
      // startExam's legacy fallback instead.
      allow create: if canWriteOwned(request.resource.data.ownerType,
                                     request.resource.data.ownerId)
                       && (request.resource.data.get('status', 'draft') != 'active'
                           || 'securityLockedAt' in request.resource.data);
      // Owners edit freely UNTIL the first attempt sets securityLockedAt
      // (stamped by the startExam Cloud Function via the Admin SDK, which
      // bypasses these rules). Once locked, the security-relevant fields are
      // immutable; schedule / access / cosmetic fields may still change.
      // Legacy docs (no securityLockedAt) remain fully editable — they carry
      // no security config to protect.
      allow update: if canWriteOwned(resource.data.ownerType, resource.data.ownerId)
                       // allocationMode is stamped by the resolveAllocation Cloud
                       // Function (Admin SDK) — clients may never set or change it.
                       && request.resource.data.get('allocationMode', null)
                            == resource.data.get('allocationMode', null)
                       // P-01: going live requires the security freeze. Fires only
                       // on the draft → active transition; an already-active doc
                       // (including a legacy one with no stamp) is unaffected, so
                       // schedule and access edits on running exams still work.
                       && (resource.data.get('status', 'draft') == 'active'
                           || request.resource.data.get('status', 'draft') != 'active'
                           || 'securityLockedAt' in request.resource.data)
                       && (
                            !('securityLockedAt' in resource.data)
                            || (
                                 request.resource.data.securityTier == resource.data.securityTier
                                 && request.resource.data.deliveryMode == resource.data.deliveryMode
                                 && request.resource.data.requireCamera == resource.data.requireCamera
                                 && request.resource.data.allowMobile == resource.data.allowMobile
                                 && request.resource.data.requireExtensionCheck == resource.data.requireExtensionCheck
                                 && request.resource.data.autoResume == resource.data.autoResume
                                 && request.resource.data.securityLockedAt == resource.data.securityLockedAt
                               )
                          );
      allow delete: if canWriteOwned(resource.data.ownerType,
                                     resource.data.ownerId);
    }

    // attempts/{id}
    //   create: webOwner only (manual-repair escape hatch). Attempt docs are
    //     created EXCLUSIVELY by the startExam Cloud Function (Admin SDK,
    //     bypasses these rules) — students must NOT be able to create them
    //     directly, or a forged doc with status:'submitted' + fabricated
    //     scores would land straight in the roster and results pages, which
    //     trust the doc. (Audit 2026-07-17, N1: the previous C1 fix hardened
    //     updates but left the student create clause open.)
    //   update:
    //     • student — only while in_progress, and only on a whitelisted set of
    //       fields the exam shell needs (answers, timings, integrity log,
    //       session tracking). Status transitions, scores, gradedAnswers,
    //       submittedAt, freeze fields, and identity fields are OFF-LIMITS to
    //       the student client; those are written by the gradeAttempt Cloud
    //       Function (admin SDK, bypasses these rules).
    //     • institute / faculty (same institute as the attempt) — ONLY the
    //       invigilation fields their UIs actually write: freeze/unfreeze
    //       (frozenAt, frozenBy, frozenReason, totalFrozenSeconds), soft-delete
    //       (isDeleted), and updatedAt. Scores, gradedAnswers, answers and
    //       status are staff-immutable at this layer — grading flows ONLY
    //       through the gradeAttempt / regradeAttempts Cloud Functions, for
    //       every role. Frozen state is frozenAt != null; status is never
    //       touched by freeze. (Audit 2026-07-17, N3: without this whitelist,
    //       staff at any participating institute could silently rewrite
    //       grades on attempts of exams they don't own, e.g. webOwner-run
    //       platform exams.)
    //     • webOwner — unrestricted (platform owner; manual repair).
    //   delete: hard-blocked — soft-delete (isDeleted=true) via staff update.
    // ── Phase 2.5: sequential delivery (linear / adaptive) ──────────
    // In linear/adaptive the SERVER owns answer writes, via the
    // submitAnswerAndAdvance callable (Admin SDK → bypasses these rules).
    // A student must not be able to updateDoc an answer directly, or the
    // strict-linear lock (and the "never holds the paper" guarantee) would
    // be trivially bypassable from DevTools. Standard mode keeps its fast
    // direct client writes; legacy attempts (no securityConfig) behave as
    // standard, so nothing regresses.
    function attemptIsSequentialDelivery() {
      return 'securityConfig' in resource.data
          && 'deliveryMode' in resource.data.securityConfig
          && (resource.data.securityConfig.deliveryMode == 'linear'
              || resource.data.securityConfig.deliveryMode == 'adaptive');
    }
    function studentAnswerWriteAllowed() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['answers'])
          || !attemptIsSequentialDelivery();
    }

    // Staff (institute / faculty) invigilation whitelist — the ONLY fields
    // their client code writes (verified against submissionService.ts:
    // freezeAttempt, unfreezeAttempt). hasOnly() gates top-level keys of the
    // patch, same mechanism as the student whitelist.
    //
    // S-03 (audit 2026-07-26): 'isDeleted' was on this list, which let any
    // institute or faculty in the owning tenant soft-delete any attempt. That
    // contradicted the deletion rights model, where WEBOWNER_ONLY_RESOURCES
    // names 'attempt' for a specific reason — attempts ARE the audit trail of
    // an exam, so a tenant able to delete them can delete the evidence of what
    // happened in one, including evidence about itself. Worse, the client did
    // it with a bare updateDoc, so nothing recorded that it had happened.
    //
    // Deletion now goes through the softDeleteAttempt callable: webOwner only,
    // and it writes the deletionAudit row in the same transaction as the state
    // change.
    //
    // F-12 (audit 2026-08-03): FREEZE LEFT THIS LIST TOO, and the reason is
    // sharper than the deletion one.
    //
    // The four freeze fields were here because the roster used to freeze with a
    // bare updateDoc. It does not any more — submissionService.freezeAttempt
    // and unfreezeAttempt have called the freezeAttempt / unfreezeAttempt
    // callables since Phase 4 — so this whitelist authorised nothing the
    // product still does, while leaving two holes open:
    //
    //   'totalFrozenSeconds' is CONSUMED AS CREDIT. examTimingCore's
    //   CONSUME_LEGACY_FROZEN_SECONDS is true, so on an attempt with no ledger
    //   creditedFreezeMs() reads this field directly. A single
    //   updateDoc({totalFrozenSeconds: 86400}) from any faculty account in the
    //   tenant granted a student twenty-four hours — bypassing the ledger, the
    //   Math.min(granted, elapsed) cap that makes over-granting impossible, the
    //   §3/§8 authority ladder, and the audit row. The same write with 0
    //   destroys credit the student was already given, which is INV-4a from a
    //   browser console. "Freeze credit cannot create time" was not an
    //   invariant while this line existed.
    //
    //   'frozenAt' alone pauses the CLIENT (ExamShell derives isFrozen from it)
    //   without opening a ledger entry, so effectiveNowMs never pins and the
    //   server's clocks keep running behind a stopped display. That is D-03,
    //   reconstructible by hand.
    //
    // Both are callable-only now, and both callables record who did it.
    // 'updatedAt' stays: it is the one field staff UIs touch that carries no
    // authority, and dropping it would break unrelated writes.
    function staffAttemptUpdateFieldsAllowed() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'updatedAt'
      ]);
    }

    function studentAttemptUpdateFieldsAllowed() {
      // hasOnly() checks TOP-LEVEL keys of the patch. Dot-path writes like
      // `answers.q_xyz` count as changes to the top-level parent key, so this
      // gates every legitimate direct write.
      //
      // NOTE: sectionTimings / sectionIds / currentSectionIdx are DELIBERATELY
      // excluded — all time transitions (exam start, section start/submit,
      // break) flow through the startExam / startSection / submitSection
      // Cloud Functions (admin SDK, which bypasses these rules). A student can
      // no longer write section timings directly, so the per-section clock
      // cannot be forged from the browser.
      //
      // ── Phase 2 (master plan D-08 / D-09) ───────────────────────
      // THREE MORE FIELDS LEFT THIS LIST. Read this before adding any back.
      //
      // `integrityLog` — the log of the student's own violations. increment()
      // in the client was never the protection it looked like: a plain
      // updateDoc could reset the whole object to zeros, counters included, so
      // a student could erase their own record mid-exam. It is now written
      // exclusively by the logViolation callable, which is append-only and
      // server-incremented. A reported violation can no longer be un-reported.
      //
      // `activeSessionId` / `sessionConflictAt` — dual-device detection. These
      // were writable but compared by nothing, so the conflict overlay was
      // decoration. registerSession is now a callable holding a transaction:
      // the swap is atomic, the conflict is recorded where the student cannot
      // suppress it, and every exam TRANSITION callable refuses a superseded
      // session. Leaving them writable here would let a second device simply
      // echo back the id it reads off the attempt and re-claim the sitting.
      //
      // What remains is `answers` — which is correct, and is what keeps
      // standard-mode autosave fast — plus `updatedAt`.
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'answers',
        'updatedAt'
      ]);
    }

    // Is this attempt's ANSWER-write window still open? (audit 2026-07-28)
    //
    // Scoped to patches that actually touch `answers`, exactly like
    // studentAnswerWriteAllowed above. The first version of this gated EVERY
    // student attempt write and broke resume: arriving at an expired exam, the
    // client claims the session by writing activeSessionId
    // (submissionService:918/926), that write was denied, and the shell died
    // with a raw "Missing or insufficient permissions" instead of showing the
    // student their time was up and auto-submitting cleanly. Claiming a
    // session, recording an integrity event or bumping updatedAt are not
    // answering — only answering has to stop at the deadline.
    //
    // answersLockedAfter is a materialized Timestamp written by startExam and
    // recomputed by startSection: the EARLIER of the current section's
    // deadline and the whole exam's, grace included. It exists as a stored
    // instant because every other clock anchor on the attempt is an ISO STRING
    // and rules cannot parse a string into a timestamp.
    //
    // Before this, these rules had no time dimension whatsoever. A student
    // whose attempt was in_progress could write answers indefinitely: leave
    // mid-exam, return after the clock ran out, keep working. Time was checked
    // only inside submitSection and gradeAttempt, both of which the STUDENT
    // triggers, so the limits were advisory.
    //
    // Absent or null means NO time bound, deliberately: exams with neither a
    // section nor an overall limit are genuinely unbounded, and attempts
    // created before this field existed must keep working rather than have
    // every in-flight exam freeze on deploy. Those are closed by the
    // scheduledCloseExpiredAttempts sweep instead. A student cannot exploit
    // the default — answersLockedAfter is not in
    // studentAttemptUpdateFieldsAllowed, so they can neither set nor clear it.
    function answerWriteWindowOpen() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['answers'])
          || resource.data.get('answersLockedAfter', null) == null
          || request.time < resource.data.answersLockedAfter;
    }

    // ── Provisional grades (Phase 4.4 / A9) ──────────────────────
    //
    // A staff-only preview of where a PAUSED student had got to. It exists as
    // its own collection rather than as fields on the attempt for one reason
    // above all: the student can read their own attempt, and A9 says a frozen
    // student must not see a result that is not final. Keeping the mark out of
    // the attempt document makes that structural instead of a UI promise.
    //
    // NO STUDENT READ. Not narrowed by studentId, not readable "only their
    // own" — students have no access to this collection at all. It also holds
    // gradedAnswers, so a read would hand over answer keys mid-sitting.
    //
    // Writes are callable-only. gradeProvisional creates the row and
    // unfreezeAttempt deletes it in the same transaction as the release, so
    // the grade cannot outlive the pause that justified it. A client write
    // would let a stale mark survive an unfreeze, which is the one thing A9
    // names as the failure to avoid.
    match /provisionalGrades/{attemptId} {
      allow read:   if isWebOwner()
                       || ((role() == 'institute' || role() == 'faculty')
                           && request.auth.token.instituteId == resource.data.instituteId);
      allow write:  if false;
    }

    match /attempts/{id} {
      allow read: if isWebOwner()
                     || (role() == 'student'
                         && resource.data.studentId == request.auth.token.studentId)
                     || ((role() == 'institute' || role() == 'faculty')
                         && request.auth.token.instituteId == resource.data.instituteId);

      allow create: if isWebOwner();

      // 'frozen' is accepted alongside 'in_progress' on the student path
      // (2026-08-03), and the reason is the flush-on-freeze. A pause now sets
      // status:'frozen' so the transition callables refuse a paused student —
      // but the client only LEARNS of a freeze through its snapshot listener,
      // and the first thing it does on learning is flush the answer sitting
      // in the 1.5s debounce window. Requiring in_progress on both sides
      // denied exactly that write, in exactly the case it exists for: the
      // selection in front of a student at the instant they were paused was
      // lost if the tab closed before release. saveAnswerNoAdvance documents
      // the same posture for sequential delivery, in the same words.
      //
      // The exposure this accepts is bounded: the whitelist still limits the
      // patch to answers+updatedAt (status cannot be changed — a status edit
      // would appear in affectedKeys and fail hasOnly), and
      // answerWriteWindowOpen still bounds it in time by the materialised
      // lock, which an open freeze holds in place server-side.
      allow update: if isWebOwner()
                       || (role() == 'student'
                           && resource.data.studentId == request.auth.token.studentId
                           && (resource.data.status == 'in_progress'
                               || resource.data.status == 'frozen')
                           && (request.resource.data.status == 'in_progress'
                               || request.resource.data.status == 'frozen')
                           && studentAttemptUpdateFieldsAllowed()
                           && studentAnswerWriteAllowed()
                           && answerWriteWindowOpen())
                       || ((role() == 'institute' || role() == 'faculty')
                           && request.auth.token.instituteId == resource.data.instituteId
                           && staffAttemptUpdateFieldsAllowed());

      allow delete: if false;
    }

    match /questions/{id} {
      // Students are DENIED direct reads: published assessments expose
      // question ids, so `signedIn()` reads let any student dump the whole
      // bank's content from the console. Students receive question content
      // ONLY via the getExamQuestions Cloud Function (whitelisted fields,
      // assessment-scoped, assignment-checked).
      //
      // TENANT FENCE (permission-model Phase 0 — replaces the former SEAM
      // that let any institute/faculty read any question's content):
      // staff read = webOwner content + anything authored inside the
      // caller's OWN institute. Cross-institute content is unreadable.
      // Fine-grained "shared with me" visibility (grants / peer shares)
      // stays enforced in the service layer, exactly like grants today —
      // this wall is what rules can enforce cheaply and provably.
      //
      //   • instituteId is the tenant stamp: present on institute- and
      //     faculty-authored questions (faculty stamps carry their
      //     institute), absent on webOwner content. The backfill script
      //     stamps legacy and pre-fence docs.
      //   • legacy docs (no ownerType) read as webOwner-owned via .get().
      //   • query provability: own-bank pages filter ownerType+ownerId
      //     (own branch); grant + review batches filter
      //     ownerType=='webOwner'; peer-share batches filter
      //     instituteId==caller's. Unfiltered scans are webOwner-only.
      allow read: if isWebOwner()
                  || (role() == 'institute'
                      && (resource.data.get('ownerType', 'webOwner') == 'webOwner'
                          || resource.data.get('instituteId', '') == request.auth.token.instituteId
                          || (resource.data.get('ownerType', '') == 'institute'
                              && resource.data.get('ownerId', '') == request.auth.token.instituteId)))
                  || (role() == 'faculty'
                      && (resource.data.get('ownerType', 'webOwner') == 'webOwner'
                          || resource.data.get('instituteId', '') == request.auth.token.instituteId
                          || (resource.data.get('ownerType', '') == 'faculty'
                              && resource.data.get('ownerId', '') == request.auth.token.facultyId)));
      // Legacy questions may lack ownerType — treat as webOwner-owned.
      // Stamp validation: institute/faculty-authored docs must carry the
      // AUTHOR's own institute as instituteId (prevents planting a question
      // into another tenant's visibility); webOwner content never carries
      // one. Enforced on the FINAL doc state for both create and update
      // (updates are partial merges client-side, so backfilled stamps
      // survive edits untouched).
      // WRITES: webOwner only (audit 2026-07-26, S-02).
      //
      // These previously read `canWriteOwned(...) && questionInstituteStampOk(...)`,
      // which checks IDENTITY and TENANT but knows nothing about
      // questionRightsCeiling or Faculty.questionRights. The entire Phase
      // 2A/2B/3 rights model — ceilings, per-faculty grants, direct vs request
      // mode, the approvals inbox — lives inside assertQuestionRight, which
      // only runs when a client chooses to call createQuestionAsRole /
      // editQuestionAsRole / deleteQuestionAsRole. Nothing forced that choice,
      // so a faculty member with zero grants could create, edit and delete
      // their own questions straight from the console, and an institute whose
      // ceiling forbade a right could exercise it anyway. The feature was
      // decorative for anyone willing to open DevTools.
      //
      // The tenant fence was never the weak part — cross-institute stamping
      // and forging webOwner-owned content were correctly denied, and still
      // are. The gap was entirely WITHIN a caller's own institute.
      //
      // Narrowing to isWebOwner() makes the callables the only way in for
      // institute and faculty, which is where the ceiling is actually
      // enforced. webOwner keeps the direct path because the ceiling exists to
      // constrain tenants and the platform owner is who sets it —
      // assertQuestionRight has no webOwner branch by design.
      //
      // KEEP IN SYNC: every institute/faculty write path must go through a
      // callable. At the time of writing those are createQuestionAsRole,
      // editQuestionAsRole, deleteQuestionAsRole, createQuestionsBulkAsRole,
      // and the approval path in resolveQuestionRequest. Adding a new
      // client-side write to this collection will fail silently for every role
      // except webOwner — that is the intended behaviour, not a bug to route
      // around by loosening this rule.
      // Scoped to webOwner-OWNED docs, not simply to the webOwner principal.
      // `if isWebOwner()` alone would have been a privilege EXPANSION hidden
      // inside a restriction: the old rule was canWriteOwned(...), whose
      // webOwner branch only matches ownerType == 'webOwner', so the platform
      // owner could never directly write an institute- or faculty-authored
      // question. Preserving that exactly keeps this change subtractive, which
      // is the property that makes it safe to ship. webOwner still administers
      // that content through the callables and the lifecycle tooling, as
      // before.
      allow create: if isWebOwner()
                       && request.resource.data.get('ownerType', 'webOwner') == 'webOwner';
      allow update, delete: if isWebOwner()
                               && resource.data.get('ownerType', 'webOwner') == 'webOwner';
    }

    // ── Question groups (Phase 1) ─────────────────────────────────
    //
    // A group holds the SHARED STIMULUS for a set of questions — a DI table,
    // a reading passage, a caselet, a puzzle or seating scenario. Its children
    // are ordinary documents in /questions and are governed by the block
    // above; this collection governs the stimulus alone.
    //
    // The rules here MIRROR /questions deliberately, clause for clause. The
    // stimulus is not lesser content than the questions hanging off it: a
    // leaked reading passage burns the whole set just as surely as a leaked
    // answer key does, because the set cannot be reused once candidates have
    // seen the passage. Anywhere the two blocks diverge is a bug — a group
    // readable by a tenant whose children are not renders a passage with no
    // questions under it, and the reverse renders questions with no passage.
    //
    //   • STUDENTS ARE DENIED, exactly as for /questions. Published
    //     assessments expose question ids, and a group id is one hop away, so
    //     a signedIn() read here would let any student pull every passage and
    //     chart in the bank from the console. Students receive stimulus
    //     content ONLY through the getExamQuestions Cloud Function, which
    //     whitelists fields and scopes to the caller's own paper.
    //   • TENANT FENCE — staff read webOwner content plus anything authored
    //     inside their OWN institute; cross-institute content is unreadable.
    //     instituteId is the tenant stamp, absent on webOwner content, and a
    //     group always carries the same stamps as its children.
    //   • WRITES are webOwner-only, for the same reason as /questions: the
    //     entire questionRightsCeiling / Faculty.questionRights model lives
    //     inside assertQuestionRight, which only runs when a client calls a
    //     callable. A direct client write path would bypass the ceiling
    //     wholesale for anyone willing to open DevTools.
    //
    // KEEP IN SYNC: every institute/faculty write must go through a callable
    // (createQuestionGroupAsRole / editQuestionGroupAsRole /
    // deleteQuestionGroupAsRole). A new client-side write to this collection
    // will fail silently for every role except webOwner — intended, not a bug
    // to route around by loosening this rule.
    match /questionGroups/{id} {
      allow read: if isWebOwner()
                  || (role() == 'institute'
                      && (resource.data.get('ownerType', 'webOwner') == 'webOwner'
                          || resource.data.get('instituteId', '') == request.auth.token.instituteId
                          || (resource.data.get('ownerType', '') == 'institute'
                              && resource.data.get('ownerId', '') == request.auth.token.instituteId)))
                  || (role() == 'faculty'
                      && (resource.data.get('ownerType', 'webOwner') == 'webOwner'
                          || resource.data.get('instituteId', '') == request.auth.token.instituteId
                          || (resource.data.get('ownerType', '') == 'faculty'
                              && resource.data.get('ownerId', '') == request.auth.token.facultyId)));
      allow create: if isWebOwner()
                       && request.resource.data.get('ownerType', 'webOwner') == 'webOwner';
      allow update, delete: if isWebOwner()
                               && resource.data.get('ownerType', 'webOwner') == 'webOwner';
    }
    // correctPairs / modelAnswer for each question.
    //
    // READ — owner-scoped (was: any signed-in non-student, which let ANY
    // institute or faculty account on the platform dump EVERY answer key,
    // including other institutes' private questions and the webOwner bank):
    //   • webOwner — all keys
    //   • institute / faculty — only keys of questions they own
    //     (canWriteOwned on the answer doc's own ownerType/ownerId fields)
    //   • students — never; the gradeAttempt / regradeAttempts Cloud
    //     Functions (admin SDK, bypass rules) are the only student-facing
    //     read path, and bulk regrade also runs server-side now.
    //
    // Query provability: batched reads from the client must carry
    // where('ownerType','==',…) + where('ownerId','==',…) filters matching
    // the caller's claim (see mergeAnswers in questionBankService), or fall
    // back to per-document gets which are evaluated doc-by-doc.
    //
    // NOTE: direct field access (not .get() with a default) is deliberate —
    // it keeps owner-filtered queries provable. Legacy answer docs missing
    // ownerType/ownerId are readable by webOwner only.
    match /questionAnswers/{id} {
      allow read:   if isWebOwner()
                       || canWriteOwned(resource.data.ownerType,
                                        resource.data.ownerId);
      // WRITES: webOwner only (audit S-02) — same reasoning as the questions
      // collection above, and they must move together. The answer key is the
      // half of a question that matters most: leaving these writable by
      // identity alone would let a faculty member with no edit right rewrite
      // the correct answer of their own question directly, which is the
      // sharpest version of the bypass rather than a lesser one.
      //
      // READS are deliberately unchanged. The owner-scoped read is what lets
      // an author see their own keys, and it is not part of this finding.
      //
      // Scoped to webOwner-owned docs for the same reason as the questions
      // collection: the old canWriteOwned() never let the webOwner write
      // institute- or faculty-authored answer keys, and this change must not
      // quietly grant that.
      allow create: if isWebOwner()
                       && request.resource.data.get('ownerType', 'webOwner') == 'webOwner';
      allow update, delete: if isWebOwner()
                               && resource.data.get('ownerType', 'webOwner') == 'webOwner';
    }

    // attemptVerdicts — one judge verdict per (attempt, coding question).
    //
    // NO STUDENT READ, AND THAT IS THE ENTIRE POINT OF THE COLLECTION.
    //
    // A student may read their own attempt document, so a verdict stored there
    // would hand them the hidden test suite: not only the captured output, but
    // the per-test pass/fail list, which is an oracle on its own — run, see
    // which hidden test flipped, and the suite is reconstructable by bisection
    // without its text ever being displayed. Verdicts therefore live here, in
    // a collection shaped like questionAnswers rather than like attempts, for
    // exactly the reason questionAnswers is separate from questions.
    //
    // Writes are server-only. The Admin SDK bypasses these rules, so denying
    // every client write costs the judge pipeline nothing and closes the path
    // where a candidate posts their own passing verdict.
    match /attemptVerdicts/{id} {
      allow read: if isWebOwner()
                     || ((role() == 'institute' || role() == 'faculty')
                         && request.auth.token.instituteId == resource.data.instituteId);
      allow create, update, delete: if false;
    }

    // attemptManualMarks — one human award per (attempt, question).
    //
    // NO STUDENT READ, and the mark itself is not the reason — the student is
    // meant to see the mark, and does: setManualMark re-scores the attempt, so
    // the award reaches them through gradedAnswers and their totals, on the
    // same document they already read. What lives here and must not follow it
    // is the grading record ABOUT the mark: which member of staff awarded it,
    // under which role, when, and how many times it has been revised. That is
    // an internal record of a colleague's work, and the argument for keeping
    // it out of a student-readable document is the one attemptVerdicts and
    // provisionalGrades already make.
    //
    // Feedback written for the student is the deliberate exception, and it
    // crosses by being COPIED into gradedAnswers under the review-audience
    // gate — never by opening this collection up.
    //
    // Writes are server-only. setManualMark is the sole author: it is the
    // thing that validates the award against the question's marks ceiling,
    // refuses to overwrite a judge's verdict, and re-scores the paper. A
    // client write would be a mark with none of that attached to it.
    match /attemptManualMarks/{id} {
      allow read: if isWebOwner()
                     || ((role() == 'institute' || role() == 'faculty')
                         && request.auth.token.instituteId == resource.data.instituteId);
      allow create, update, delete: if false;
    }

    // attemptTelemetry — the record of HOW a candidate wrote their answer.
    //
    // NO STUDENT READ, and for a different reason than attemptVerdicts.
    //
    // A verdict is withheld because it leaks the answer key. This is withheld
    // because it is a recording of a person working — hesitation, deletion,
    // false starts, things they chose not to submit — and handing someone back
    // a keystroke-level transcript of themselves under exam conditions serves
    // no purpose the platform has. Staff of the owning institute may read it,
    // because they are the ones who would ever have cause to.
    //
    // Writes are server-only. Append-only chunks written by recordCodeTelemetry
    // through the Admin SDK, which bypasses these rules — so denying every
    // client write costs the capture path nothing and closes the path where a
    // candidate edits their own record of what they did.
    match /attemptTelemetry/{id} {
      allow read: if isWebOwner()
                     || ((role() == 'institute' || role() == 'faculty')
                         && request.auth.token.instituteId == resource.data.instituteId);
      allow create, update, delete: if false;
    }

    // questionBanks — owned by Web Owner only (no instituteId on the doc).
    match /questionBanks/{id} {
      allow read:   if isStaff();   // L-b: students have no reason to enumerate share/grant metadata
      allow create, update, delete: if isWebOwner();
    }

    // bankGrants (Web Owner → Institute) — only Web Owner mutates.
    match /bankGrants/{id} {
      allow read:   if isStaff();   // L-b: students have no reason to enumerate share/grant metadata
      allow create, update, delete: if isWebOwner();
    }

    // instituteGrants (Institute Admin → Faculty within the same institute).
    match /instituteGrants/{id} {
      allow read:   if isStaff();   // L-b: students have no reason to enumerate share/grant metadata
      allow create: if isWebOwner()
                       || isInstituteOf(request.resource.data.instituteId);
      allow update: if isWebOwner()
                       || isInstituteOf(resource.data.instituteId);
      allow delete: if isWebOwner()
                       || isInstituteOf(resource.data.instituteId);
    }

    // questionShares — sender (institute or faculty) writes; recipient reads.
    // sharedByInstituteId must match the caller's institute claim, and
    // sharedBy must match the caller's institute/faculty id.
    function canWriteShare(d) {
      return isWebOwner()
        || (d.sharedByType == 'institute'
            && role() == 'institute'
            && request.auth.token.instituteId == d.sharedByInstituteId
            && request.auth.token.instituteId == d.sharedBy)
        || (d.sharedByType == 'faculty'
            && role() == 'faculty'
            && request.auth.token.instituteId == d.sharedByInstituteId
            && request.auth.token.facultyId   == d.sharedBy);
    }
    match /questionShares/{id} {
      allow read:   if isStaff();   // L-b: students have no reason to enumerate share/grant metadata
      allow create: if canWriteShare(request.resource.data);
      allow update: if canWriteShare(resource.data);
      allow delete: if canWriteShare(resource.data);
    }

    // questionRequests — Phase 3 request/approval workflow. Faculty raise
    // requests for actions their grant only permits in request mode; the
    // institute admin resolves them. All WRITES that matter (create the
    // request, approve/reject) go through the submitQuestionRequest /
    // resolveQuestionRequest callables, which enforce rights + execute
    // server-side; these rules just scope who can READ the queue and act as
    // a backstop on direct writes.
    //   • faculty  — read/write their OWN requests within their institute
    //   • institute admin — read/write requests inside their institute
    //   • webOwner — full
    function ownsRequest(d) {
      return isWebOwner()
        || (role() == 'institute' && request.auth.token.instituteId == d.instituteId)
        || (role() == 'faculty'
            && request.auth.token.instituteId == d.instituteId
            && request.auth.token.facultyId   == d.facultyId);
    }
    match /questionRequests/{id} {
      allow read:   if ownsRequest(resource.data);
      allow create: if ownsRequest(request.resource.data);
      allow update: if ownsRequest(resource.data);
      allow delete: if isWebOwner();
    }

    // questionReports — student files; assessment owner (institute or faculty)
    // resolves; webOwner override.
    function canResolveReport(d) {
      return isWebOwner()
        || (d.ownerType == 'institute'
            && role() == 'institute'
            && request.auth.token.instituteId == d.ownerId)
        || (d.ownerType == 'faculty'
            && role() == 'faculty'
            && request.auth.token.facultyId == d.ownerId)
        || (role() == 'institute'
            && d.instituteId is string
            && request.auth.token.instituteId == d.instituteId);
    }
    match /questionReports/{id} {
      // Read: reporters see their own; reviewers (owner/institute/faculty)
      // see reports scoped to their institute. Cross-institute read blocked.
      allow read: if isWebOwner()
                     || (role() == 'student'
                         && resource.data.studentId == request.auth.token.studentId)
                     || ((role() == 'institute' || role() == 'faculty')
                         && resource.data.instituteId is string
                         && request.auth.token.instituteId == resource.data.instituteId);
      // L-c: a student's report may not carry another institute's id (was
      // injectable noise into that institute's inbox). Tolerates absence —
      // reports on webOwner-owned exams may omit instituteId.
      allow create: if isWebOwner()
                       || (role() == 'student'
                           && request.resource.data.studentId == request.auth.token.studentId
                           && (!('instituteId' in request.resource.data)
                               || request.resource.data.instituteId == request.auth.token.instituteId));
      allow update: if canResolveReport(resource.data);
      allow delete: if isWebOwner();
    }

    // subjects — global taxonomy, Web Owner only.
    match /subjects/{id} {
      allow read:   if signedIn();
      allow create, update, delete: if isWebOwner();
    }

    // topics — child of subjects (subjectId field), Web Owner only.
    match /topics/{id} {
      allow read:   if signedIn();
      allow create, update, delete: if isWebOwner();
    }

    // enrollments — RETIRED (L-a, 2026-07-17). Zero client callers remain;
    // membership went to assessmentMembers (rules mode) / assignedTo (legacy).
    // Explicit deny kept as a tombstone so a stray write fails loudly here
    // rather than falling through to the default.
    match /enrollments/{id} {
      allow read, write: if false;
    }

    // ═════════════════════════════════════════════════════════════════════════
    // ALLOCATION SYSTEM (Phase B — plans/ALLOCATION_SYSTEM_PLAN.md)
    // All three collections are written EXCLUSIVELY by Cloud Functions via the
    // Admin SDK (which bypasses these rules). Every client write is denied —
    // including the Web Owner's. That is the design, not an oversight:
    // membership may only change through resolveAllocation / addManualMember
    // so that every change is validated, versioned, and audited.
    // ═════════════════════════════════════════════════════════════════════════

    // allocations/{assessmentId} — the allocation definition + summaries.
    match /allocations/{assessmentId} {
      allow read:  if isWebOwner();
      allow write: if false;
    }

    // assessmentMembers/{assessmentId_studentId} — the materialized list.
    // Students may read ONLY their own membership docs — this is what powers
    // the dashboard's "which exams am I allocated to?" query (Phase C).
    match /assessmentMembers/{id} {
      allow read:  if isWebOwner()
                      || (role() == 'student'
                          && resource.data.studentId == request.auth.token.studentId);
      allow write: if false;
    }

    // allocationAudit/{autoId} — append-only history. Immutable to EVERY
    // client principal, including the Web Owner: there is nothing to edit.
    match /allocationAudit/{id} {
      allow read:  if isWebOwner();
      allow write: if false;
    }

    // ═════════════════════════════════════════════════════════════════════════
    // ENTITY LIFECYCLE (Feature #15, Phase 0b)
    // ═════════════════════════════════════════════════════════════════════════

    // deletionAudit/{autoId} — append-only lifecycle trail: archive, soft
    // delete, restore, purge, and (Phase 4) request submissions/resolutions.
    //
    // IMMUTABLE TO EVERY CLIENT PRINCIPAL, INCLUDING THE WEB OWNER.
    // Same posture as allocationAudit above, for the same reason plus a
    // stronger one: an audit trail a client can write is one a client can
    // FORGE, and an audit trail a client writes separately from the action
    // is one that can silently go missing when the second call fails. Rows
    // are written server-side by the same callable that performs the
    // transition, inside the same operation.
    //
    // READ SCOPING
    //   • webOwner  — the whole trail.
    //   • institute — only rows stamped with its own instituteId. Provable
    //     from the query: the client filters instituteId == own claim (see
    //     getAuditForInstitute in src/lib/deletionAudit.ts), so this rule
    //     never forces an unfiltered scan.
    //   • faculty / student — nothing. Faculty may TRIGGER lifecycle actions
    //     under Phase 3 rights, but the trail exists to hold actors
    //     accountable, so it is not readable by the population it audits.
    match /deletionAudit/{id} {
      allow read:  if isWebOwner()
                      || (signedIn()
                          && role() == 'institute'
                          && resource.data.instituteId == request.auth.token.instituteId);
      allow write: if false;
    }

    // deletionRequests/{autoId} — the two-hop approval workflow (Phase 4).
    //
    //   faculty  (mode 'request')      → institute admin approves
    //   institute(selfMode 'request')  → Web Owner approves
    //
    // READS are scoped so each party sees exactly their own slice:
    //   • webOwner  — everything (they are the approver for institute-raised
    //     requests, and oversee the rest).
    //   • institute — every request in their own tenant: the ones their
    //     faculty raised to them, AND the ones they raised upward, so a
    //     single inbox shows both sides of their position in the chain.
    //   • faculty   — only requests they raised themselves.
    //
    // WRITES are server-only, permanently. submitDeletionRequest and
    // resolveDeletionRequest are callables because the server must (a) verify
    // the requester actually holds the right in request mode, (b) re-check the
    // APPROVER's rights at execution time rather than submission time, and
    // (c) EXECUTE the deletion itself. A client-writable status field would
    // let a requester approve their own request.
    function ownsDeletionRequest(d) {
      return isWebOwner()
        || (role() == 'institute' && request.auth.token.instituteId == d.instituteId)
        || (role() == 'faculty'
            && request.auth.token.instituteId == d.instituteId
            && request.auth.uid == d.requesterUid);
    }
    match /deletionRequests/{id} {
      allow read:  if signedIn() && ownsDeletionRequest(resource.data);
      allow write: if false;
    }

    // subjectRequests/{autoId} — access & erasure requests (Feature #15, 7b).
    //
    // The record of who asked for their data, when they asked, and what was
    // decided — including refusals, which are as much a compliance artifact as
    // fulfilments. Reads mirror deletionRequests: webOwner everything,
    // institute its own tenant, nobody else.
    //
    // Students and faculty cannot read these, deliberately. A subject request
    // is staff correspondence ABOUT a person, not a surface FOR them; a
    // self-service view would need its own identity checks and its own
    // decisions about what a subject may see of an internal deliberation.
    //
    // Writes are server-only permanently. submitSubjectRequest and
    // decideSubjectRequest are callables so that the server can enforce the
    // duplicate-open-request rule, require a reason on refusal, and stop an
    // institute marking an ERASURE fulfilled when only the Web Owner can
    // carry one out.
    match /subjectRequests/{id} {
      allow read:  if isWebOwner()
                      || (signedIn()
                          && role() == 'institute'
                          && resource.data.instituteId == request.auth.token.instituteId);
      allow write: if false;
    }

    // ═════════════════════════════════════════════════════════════════════════
    // BLOCKED — leftover dev/test collections
    // ═════════════════════════════════════════════════════════════════════════
    match /connectionTest/{id}        { allow read, write: if false; }
    match /firebaseConnectionTest/{id}{ allow read, write: if false; }

    // Anything not explicitly matched above falls through to the default deny.
  }
}