{
  "name": "stratum-functions",
  "version": "0.1.0",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "migrate:webowners": "ts-node scripts/migrate-webowners.ts",
    "build:core": "tsc -p tsconfig.core.json && cp .tmp-core/examTimingCore.js timing-core.cjs && rm -rf .tmp-core",
    "test:timing": "npm run build:core && node timing.sweep.cjs",
    "test:freeze": "npm run build && node test/freeze.suite.cjs",
    "test:rules": "firebase emulators:exec --config ../firebase.json --only firestore,storage --project demo-rules-suite \"node test/rules.suite.cjs\"",
    "test:concurrency": "firebase emulators:exec --config ../firebase.json --only firestore --project demo-concurrency \"node test/concurrency.suite.cjs\"",
    "test": "npm run test:timing && npm run test:freeze && node test/exam.e2e.cjs && node test/groups.suite.cjs && node test/audit.probe.cjs && node test/audit.round3.cjs && node test/audit.grading.cjs && npm run test:rules && npm run test:concurrency",
    "test:e2e": "npm run build && node test/exam.e2e.cjs",
    "test:groups": "npm run build && node test/groups.suite.cjs",
    "test:probe": "npm run build && node test/audit.probe.cjs",
    "test:round3": "npm run build && node test/audit.round3.cjs",
    "test:grading": "npm run build && node test/audit.grading.cjs"
  },
  "dependencies": {
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.2.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase": "^12.10.0",
    "firebase-tools": "^15.26.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
