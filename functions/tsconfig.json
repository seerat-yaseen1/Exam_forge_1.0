{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2020",
    "lib": ["es2020"],
    "moduleResolution": "node",
    "outDir": "lib",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "noImplicitReturns": true,
    // F2 shipped a fully-built penalty ledger that was assigned and never read.
    // This is the check that would have failed the build on it.
    "noUnusedLocals": true
  },
  "include": ["src/**/*.ts"]
}
